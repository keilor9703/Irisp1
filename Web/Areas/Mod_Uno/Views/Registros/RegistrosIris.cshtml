                                                <input tabindex="5" name="txtRegistroFoto" type="text" id="txtRegistroFoto" autocomplete="on" placeholder="formato JPG o PNG, Dimensiones recomendadas (750x579), peso max 5MB" class="form-control InputPading" />
                                <span class="input-group-btn">
                                    <button tabindex="6" class="btn btn-success" id="btnGetAtencionAmbIden" onclick="GetAtencionAmbIden(); return false;" style="height:34px; border-radius: 0px 0px 0px 0px !important;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                    <button tabindex="7" class="btn btn-warning" id="btnLimpiarDatosIris" onclick="LimpiarAtencionAmbulatoria(); return false;" style="height:34px; border-radius: 0px 5px 5px 0px !important; margin-left: -5px;" type="button" title="Limpiar Consulta"><b><i class="fa fa-eraser"></i></b></button>
                                </span>
                            </div>
                            <label class="Labels">Anexo fotografico:</label>
                        </div>
                    </div>
                </div>
            </fieldset>

                <fieldset>
                    <legend style="width: calc(9em + .75rem + 2px) !important;">Datos Integrante</legend>
                    <div class="row">
                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <div class="input-group">
                                    <input tabindex="8" name="txtIdentificacionInt" type="text" id="txtIdentificacionInt" autocomplete="off" placeholder=" " class="form-control InputPading" onkeypress="return soloNumeros(event)">
                                    <span class="input-group-btn">
                                        <button tabindex="9" class="btn btn-success" id="btnGetDatosPaciente" onclick="GetDatosPaciente(); return false;" style="height:34px; border-radius: 0px;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                    </span>
                                </div>
                                <label class="Labels">No. Identificación:</label>
                            </div>
                        </div>

                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="10" id="txtApellidosInte" name="txtApellidosInte" type="text" value="" autocomplete="off" placeholder="Digite los apellidos" class="form-control InputPading">
                                <label class="Labels">Apellidos:</label>
                            </div>
                        </div>

                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="11" id="txtNombreInte" name="txtNombreInte" type="text" value="" autocomplete="off" placeholder="Digite los nombres" class="form-control InputPading">
                                <label class="Labels">Nombres:</label>
                            </div>
                        </div>

                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="12" id="txtAliasInte" name="txtAliasInte" type="text" value="" autocomplete="off" placeholder="Digite el alias si aplica" class="form-control InputPading">
                                <label class="Labels">Alias:</label>
                            </div>
                        </div>

                        <div class="card-footer" style="margin-bottom: 10px;">
                            <div class="col-md-12 text-right">
                                <button tabindex="13" type="button" id="btnAddIntegrante" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-buscar" title="Guardar Formulario">
                                    <span class="fa fa-user faa-shake animated white"></span> Añadir Integrante
                                </button>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table" id="tablaIntegrantes">
                                <thead>
                                    <tr>
                                        <th>No. Identificación</th>
                                        <th>Apellidos</th>
                                        <th>Nombres</th>
                                        <th>Alias</th>
                                        <th>Acciones</th>
                                    </tr>
                                </thead>
                                <tbody id="tbodyIntegrantes">
                                    <!-- Aquí se agregarán los integrantes -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </fieldset>
                <fieldset>
                    <legend style="width: calc(10em + .75rem + 2px) !important;">Delitos relacionados</legend>

                    <div class="row">
                        <div class="col-md-12 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlDelPrincipal", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlDelPrincipal", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Delito Principal:</label>
                            </div>
                        </div>

                        <div class="col-md-12 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.ListBox("ddlDelSecundario", new MultiSelectList(
                                         new List<SelectListItem> {
                                new SelectListItem { Text = "Seleccione", Value = "0" },
                                // Agrega más opciones aquí
                                }, "Value", "Text"), htmlAttributes: new { @tabindex = 5, @id = "ddlDelSecundario", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Delitos Asociados:</label>
                            </div>
                        </div>

                        <div class="col-md-12 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.ListBox("ddlDelSecundario", new MultiSelectList(
                                         new List<SelectListItem> {
                                new SelectListItem { Text = "Seleccione", Value = "0" },
                                // Agrega más opciones aquí
                                }, "Value", "Text"), htmlAttributes: new { @tabindex = 5, @id = "ddlDelSecundario", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Otros Delitos:</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
                <fieldset>
                    <legend style="width: calc(10em + .75rem + 2px) !important;"> Ubicacion Geografica</legend>

                    <div class="row">
                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="14" id="txtApellidos" name="txtMunicipio" type="text" value="" autocomplete="off" placeholder="Municipio" class="form-control InputPading">
                                <label class="Labels">Municipio:</label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="15" id="txtApellidos" name="txtBarrio" type="text" value="" autocomplete="off" placeholder="Barrio" class="form-control InputPading">
                                <label class="Labels">Barrio:</label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="16" id="txtDireccion" name="txtAlias" type="text" value="" autocomplete="off" placeholder="Digite la direccion" class="form-control InputPading">
                                <label class="Labels">Direccion:</label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="17" id="txtCoordenada" name="txtLatitud" type="text" value="" autocomplete="off" placeholder="Latitud" class="form-control InputPading">
                                <label class="Labels">Latitud:</label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="18" id="txtCoordenada2" name="txtLongitud" type="text" value="" autocomplete="off" placeholder="Longitud" class="form-control InputPading">
                                <label class="Labels"> Longitud:</label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="18" id="txtRadio" name="txtAlias" type="text" value="" autocomplete="off" placeholder="Digite radio de accion en Km" class="form-control InputPading">
                                <label class="Labels">Radio de accion:</label>
                            </div>
                        </div>
                    </div>
                    


                </fieldset>

                <div class="card-footer" style="margin-bottom: 10px;">
                    <div class="col-md-12 text-right">
                                    <button tabindex="1" type="button" id="btnGuardarIris" onclick="InsDatosIris(); return flase;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad" title="Guardar">
                                        <span class="fa ico_grabar faa-wrench animated"></span> Guardar </button>
                        <button type="button" data-bs-dismiss="modal" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-cerrar"><span class="fas fa-sign-out-alt faa-horizontal animated"></span> Cerrar</button>
                    </div>
                </div>
                <div class ="modal-footer"></div>
            </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>

<div class="modal fade show" id="Modal_Transacciones" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="scroll-long-outer-modal" aria-modal="true" role="dialog">
