@{
    ViewData["Title"] = "Buscar Integrantes";

}


@section scripts {

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/templatemonster_bt5/assets/libs/daterangepicker/moment.min.js"></script>
    <!-- Carga la API de ArcGIS -->
    <link rel="stylesheet" href="https://js.arcgis.com/3.23/dijit/themes/claro/claro.css">
    <link rel="stylesheet" href="https://js.arcgis.com/3.44/esri/css/esri.css">
    <script src="https://js.arcgis.com/3.44/"></script>

    @* <script src="~/areas/rutas/RutasIris.js"></script> *@
   
    <script src="~/areas/integrantes/crearubicacion.js"></script>
    <script src="~/areas/integrantes/buscarintegrantes.js"></script>
    
    <script type='text/javascript'>

        var codigoDaneInicial = 11001;

    </script>
}


<section class="content-header"></section>
<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span> Inicio </span></a></li>
            <li class="active">Instrumento de Recolección de Información del Servicio de Policía / Buscar Integrante - Reincidente IRISP1</li>
        </ul>
    </div>
</div>


 @*   BUSQUEDA POR IDENTIFICACIÓN---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@

 <div class="row">

    <div class="col-md-12">
        <div class="card border-success">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="fa fa-search"></i> Consultar</h4>
                <div class="card-actions ms-auto d-flex button-group">
                    <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
          
                        <i data-feather="x" class="feather-sm"></i>
                    </a>
                </div>
            </div>
             <div class="card-body collapse show">
                <div class="row">

                    <div class="col-md-2 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <div class="input-group">
                                <input tabindex="1" name="txtIdentificacion" type="number" id="txtIdentificacion" autocomplete="off" placeholder=" " class="form-control InputPading" />
                                <span class="input-group-btn">
                                    <button tabindex="2" class="btn btn-success" id="btnConsultarIntegrante" style="height:34px; border-radius: 0px 0px 0px 0px !important;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                    <button tabindex="3" class="btn btn-warning" id="btnLimpiarInteg" style="height:34px; border-radius: 0px 5px 5px 0px !important; margin-left: -5px;" type="button" title="Limpiar Consulta"><b><i class="fa fa-eraser"></i></b></button>
                                </span>
                            </div>
                            <label class="Labels">Identificación:</label>
                        </div>
                    </div>

                    <div class="col-md-2 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="13" id="txtAlias" name="txtAlias" type="text" autocomplete="off" placeholder="Alias si aplica" class="form-control InputPading" readonly>
                            <label class="Labels">Alias:</label>
                        </div>
                    </div>

                    <div class="col-md-2 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="13" id="txtNombres" name="txtNombres" type="text" autocomplete="off" placeholder="Nombre" class="form-control InputPading " readonly>
                            <label class="Labels">Nombres:</label>
                        </div>
                    </div>

                    <div class="col-md-2 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="13" id="txtApellidos" name="txtApellidos" type="text" autocomplete="off" placeholder="Apellidos" class="form-control InputPading " readonly>
                            <label class="Labels">Apellidos:</label>
                        </div>
                    </div>

                    <div class="col-md-4 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="13" id="txtObservacion" name="txtObservacion" type="text" autocomplete="off" placeholder="Observaciones" class="form-control InputPading " readonly>
                            <label class="Labels">Observación:</label>
                        </div>
                    </div>

                </div>
             </div>
        </div>
    </div>
    
</div>


<div class="row">

    <div class="col-md-12">
        <div class="card border-success" id="pn_GrillaListaIris">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="fa fa-male yellow"></i> El integrante se encuentra en los siguientes IRISP1</h4>
                <div class="card-actions ms-auto d-flex button-group">
                    <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
                    <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
                    <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close"><i data-feather="x" class="feather-sm"></i></a>
                </div>
            </div>
            <div class="card-body collapse show">
                <div class="row">
                    <div class="col-md-12">


                        <button id="btnExcel" class="btn btn-excel btn-sm me-2">
                            <i class="fa fa-file-excel"></i> Excel
                        </button>

                        <button id="btnPdf" class="btn btn-danger btn-sm me-2">
                            <i class="fa fa-file-pdf"></i> PDF
                        </button>



                        <div class="dt-container" style="width:100%; margin-top:0;">
                            <table id="tbGrillaListaIris" class="table table-bordered table-striped" width="100%" style="margin-top:-1px;"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>



<div class="row">

    <div class="col-md-12">
        <div class="card border-success" id="pn_GrillaUbicaciones">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="fa fa-map-marker yellow"></i> Georeferenciación consultas antecedentes por PDA</h4>
                <div class="card-actions ms-auto d-flex button-group">
                    <!-- Botón Nuevo -->
                    <button type="button"
                            class="btn btn-green btn-sm py-0 px-2 align-self-center"
                            id="btnAbrirMapaUbicaciones"
                            style="line-height:1.2; font-size: 0.8rem;">
                        <i class="fas fa-plus"></i> Ver todas las ubicaciones
                    </button>

                    <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
                   
                    
                </div>
            </div>
            <div class="card-body collapse show">
                <div class="row">
                    <div class="col-md-12">


                        <button id="btnExcel2" class="btn btn-excel btn-sm me-2">
                            <i class="fa fa-file-excel"></i> Excel
                        </button>

                        <button id="btnPdf2" class="btn btn-danger btn-sm me-2">
                            <i class="fa fa-file-pdf"></i> PDF
                        </button>

                        <div class="dt-container" style="width:100%; margin-top:0;">
                            <table id="tbGrillaUbicaciones" class="table table-bordered table-striped" width="100%" style="margin-top:-1px;"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@* Modal para visualizar texto *@
<div class="modal fade" id="Modal_VisualizarTexto" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog modal-l" role="document">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel2">Descripción</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" width="100%" height="2000px">
                <div class="row">
                    <div class="col-md-12 MargFloatBoos">
                        <div class="form-group has-float-label d-flex align-items-center">
                            <textarea style="height: 95px !important; text-align:justify; margin-bottom: 0px;" name="txtDescripcion" type="text" id="txtDescripcion" value="" autocomplete="off" class="form-control InputPading" readonly></textarea>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- INICIO DE MODAL VER UBICACION ANTCEDENTE-->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="mapModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mapModalLabel">Mapa de Ubicación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-12 mb-2">
                    <input id="direccionmapa" type="text" class="form-control" placeholder="Buscar dirección..." />
                </div>

                <!-- Aquí irá el mapa -->
                <div id="mapaDiv" style="width: 100%; height: 600px;"></div>
            </div>

        </div>
    </div>
</div>
