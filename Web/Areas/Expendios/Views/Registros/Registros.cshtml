<!-- /.modal-Crear Integrante IRISP1 -->

<div class="modal fade" id="Modal_InsIntegrantesExendios" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 900px;">

        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel" style="font-weight: bold;">Ingresar Nuevo Ingrante</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>


            <div class="modal-body">

               

                <div class="row">
                    <div class="col-md-4 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <div class="input-group">
                                <input tabindex="1" name="txtIdentificacion" type="text" id="txtIdentificacion" autocomplete="off" placeholder=" " class="form-control InputPading" />
                                <span class="input-group-btn">
                                    <button tabindex="2" class="btn btn-success" id="btnConsultarEmpl" onclick="F_GetFuncionarios ($('#txtIdentificacion').val()); return false;" style="height:34px; border-radius: 0px 0px 0px 0px !important;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                    <button tabindex="3" class="btn btn-warning" id="BtnLimpiarEmpl" onclick="Limpiar(); return false;" style="height:34px; border-radius: 0px 5px 5px 0px !important; margin-left: -5px;" type="button" title="Limpiar Consulta"><b><i class="fa fa-eraser"></i></b></button>
                                </span>
                            </div>
                            <label class="Labels">Identificación:</label>
                        </div>
                    </div>

                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="13" id="txtAliasModal" name="txtAliasModal" type="text" autocomplete="off" placeholder="Digite el alias si aplica" class="form-control InputPading">
                            <label class="Labels">Alias:</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="12" id="txtNombreIntegModal" name="txtNombreIntegModal" type="text" autocomplete="off" placeholder="Digite los nombres" class="form-control InputPading">
                            <label class="Labels">Nombres:</label>
                        </div>
                    </div>

                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="11" id="txtApellidosIntegModal" name="txtApellidosIntegModal" type="text" autocomplete="off" placeholder="Digite los apellidos" class="form-control InputPading">
                            <label class="Labels">Apellidos:</label>
                        </div>
                    </div>

                                       
                </div>

               

            </div>
            <div class="modal-footer" style="justify-content:center;">

                <button tabindex="14" type="button" id="btnAddIntegranteExpendio" onclick="InsIntegrantesExpendiosModal(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad"><span class="fa ico_grabar faa-wrench animated"></span>Guardar</button>
            </div>
        </div>
    </div>
</div>



@* Modal para insertar delitos  *@

<div class="modal fade" id="Modal_InsDelitosExpendios" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 900px;">

        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel" style="font-weight: bold;">Ingresar Delito</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>


            <div class="modal-body">

             
                <div class="row">
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            @Html.DropDownList("ddlDelitoModal", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlDelitoModal", @class = "form-control select2", style = "width: 100%;" })
                            <label class="Labels">Delito:</label>
                        </div>
                    </div>
                </div>


            </div>
            <div class="modal-footer" style="justify-content:center;">

                <button tabindex="14" type="button" id="btnAddDelitosExpendios" onclick="P_InsDelitosModal(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad"><span class="fa ico_grabar faa-wrench animated"></span>Guardar</button>
            </div>
        </div>
    </div>
</div>


@* Modal para insertar información adicional  *@

<div class="modal fade" id="Modal_InsInfoBitacora" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 900px;">

        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel" style="font-weight: bold;"> Registrar Información </h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>


            <div class="modal-body">

             

                <div class="row">


                    <div class="col-md-12 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <textarea tabindex="12" id="txtInfoBitacoraModal" name="txtInfoBitacoraModal"
                                      placeholder="Digite Información"
                                      class="form-control InputPading" rows="6"
                                      style="resize: vertical; min-height: 150px;"></textarea>
                            <label class="Labels">Información:</label>
                        </div>
                    </div>

                </div>


            </div>
            <div class="modal-footer" style="justify-content:center;">

                <button tabindex="14" type="button" id="btnAddInfoBitacora" onclick="P_InsInfoAdicionalModal(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad"><span class="fa ico_grabar faa-wrench animated"></span>Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Crear Resultados Expendios -->

<div class="modal fade" id="Modal_InsResultadosExendios" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 900px;">

        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel" style="font-weight: bold;">Ingresar Nuevo Ingrante</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>


            <div class="modal-body">



                <div class="row">
                   
                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlTipoResultado", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlTipoResultado", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Tipo:</label>
                            </div>
                        </div>
                 


                    
                    <div class="col-md-4 MargFloatBoos">
                        <div class="form-group has-float-label">
                            @Html.DropDownList("ddlSubTipoResultado", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlSubTipoResultado", @class = "form-control select2", style = "width: 100%;" })
                            <label class="Labels">Subtipo:</label>
                        </div>
                    </div>
                   

                </div>

                <div class="row">
                    <div class="col-md-3 MargFloatBoos">
