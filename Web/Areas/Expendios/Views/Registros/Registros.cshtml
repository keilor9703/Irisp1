                            <label class="Labels">Alias:</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="12" id="txtNombreIntegModalUpd" name="txtNombreIntegModalUpd" type="text" autocomplete="off" placeholder="Digite los nombres" class="form-control InputPading">
                            <label class="Labels">Nombres:</label>
                        </div>
                    </div>

                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="11" id="txtApellidosIntegModalUpd" name="txtApellidosIntegModalUpd" type="text" autocomplete="off" placeholder="Digite los apellidos" class="form-control InputPading">
                            <label class="Labels">Apellidos:</label>
                        </div>
                    </div>


                </div>



            </div>
            <div class="modal-footer" style="justify-content:center;">

                <button tabindex="14" type="button" id="btnUpdIntegranteExpendio" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad"><span class="fa ico_grabar faa-wrench animated"></span>Actualizar</button>
            </div>
        </div>
    </div>
</div>



