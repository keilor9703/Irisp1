@{
    ViewData["Title"] = "Administración Usuarios";
}

@section scripts {
    @* <script src="~/areas/rutas/RutasIris.js"></script> *@
  
    <script src="~/areas/admin/VwUsuarios.js?v=1"></script>

   
   
}
<input type="text" id="txtIdUsuario" class="hidden" />
<section class="content-header"></section>
<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span>Inicio</span></a></li>
            <li class="active">Administración Usuarios</li>
        </ul>
    </div>
</div>
<div class="card border-success">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fa fa-pencil-square-o text-white"></i>Administración de Usuarios</h4>
        <div class="card-actions ms-auto d-flex button-group">
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="row">
            <div class="col-md-2 text-center">
                <div class="form-group">
                    <img id="imgFoto" src="~/img/Avatar.png" class="img-circle" style="width: 157px;height: 196px; border-radius: 3px; padding: 1px; border:1px solid #021a40; -webkit-box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5); box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.5);">
                </div>
            </div>
            <div class="col-md-10">
                <div class="row">
                    <div class="col-md-3 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <div class="input-group">
                                <input tabindex="1" name="txtIdentificacion" type="text" id="txtIdentificacion" autocomplete="off" placeholder=" " class="form-control InputPading" />
                                <span class="input-group-btn">
                                    <button tabindex="2" class="btn btn-success" id="btnConsultarEmpl"  style="height:34px; border-radius: 0px 0px 0px 0px !important;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                    <button tabindex="3" class="btn btn-warning" id="BtnLimpiarEmpl"  style="height:34px; border-radius: 0px 5px 5px 0px !important; margin-left: -5px;" type="button" title="Limpiar Consulta"><b><i class="fa fa-eraser"></i></b></button>
                                </span>
                            </div>
                            <label class="Labels">Identificación:</label>
                        </div>
                    </div>
                    <div class="col-md-3 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="4" name="txtSituacionLab" type="text" id="txtSituacionLab" autocomplete="off" placeholder=" " class="form-control InputPading" readonly />
                            <label class="Labels">Situación Laboral:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="5" name="txtFuncionario" type="text" id="txtFuncionario" autocomplete="off" placeholder=" " class="form-control InputPading" />
                            <label class="Labels">Funcionario:</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="6" name="txtCorreo" type="text" id="txtCorreo" autocomplete="off" placeholder=" " class="form-control InputPading" readonly />
                            <label class="Labels">Correo Institucional:</label>
                        </div>
                    </div>
                    <div class="col-md-3 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="7" name="txtUserName" type="text" id="txtUserName" autocomplete="off" placeholder=" " class="form-control InputPading" readonly />
                            <label class="Labels">Usuario Institucional:</label>
                        </div>
                    </div>
                    <div class="col-md-3 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="8" name="txtCelular" type="number" id="txtCelular" autocomplete="off" placeholder=" " class="form-control InputPading" readonly />
                            <label class="Labels">Celular:</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="9" name="txtDependencia" type="text" id="txtDependencia" autocomplete="off" placeholder=" " class="form-control InputPading" readonly />
                            <label class="Labels">Unidad Labora:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            <input tabindex="10" name="txtCargo" type="text" id="txtCargo" autocomplete="off" placeholder=" " class="form-control InputPading" readonly />
                            <label class="Labels">Cargo Actual:</label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-3 MargFloatBoos">
                        <div class="form-horizontal">
                            <div class="form-group row" style="margin-bottom: 0px;">
                                <label class="col-md-7 col-form-label Labels" style="margin-top:0px;">Activar Usuario:</label>
                                <div class="col-md-5 text-left" style="padding-left:0px;">
                                    <input tabindex="11" type="checkbox" checked data-toggle="toggle" id="chkActivo">
                                </div>
                            </div>
                        </div>
                    </div>

                   @*  <div class="col-md-4 MargFloatBoos">
                        <div class="form-horizontal">
                            <div class="form-group row" style="margin-bottom: 0px;">
                                <label class="col-md-7 col-form-label Labels" style="margin-top:0px;">Activar MFA (Doble factor de autenticación):</label>
                                <div class="col-md-5 text-left" style="padding-left:0px;">
                                    <input tabindex="12" type="checkbox" checked data-toggle="toggle" id="chkMfaActivo">
                                </div>
                            </div>
                        </div>
                    </div>
 *@


                    @if (User.IsInRole("1"))
                    {
                        <div class="col-md-4 MargFloatBoos" id="contenedorMfa">
                            <div class="form-horizontal">
                                <div class="form-group row" style="margin-bottom: 0px;">
                                    <label class="col-md-7 col-form-label Labels" style="margin-top:0px;">
                                        Activar Doble Factor de Autenticación (2FA):
                                    </label>
                                    <div class="col-md-5 text-left" style="padding-left:0px;">
                                        <input tabindex="12" type="checkbox" checked data-toggle="toggle" id="chkMfaActivo">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }


                    @if (User.IsInRole("1"))
                    {
                        <div class="col-md-4 MargFloatBoos" id="contenedorTrusted">
                            <div class="form-horizontal">
                                <div class="form-group row" style="margin-bottom: 0px;">
                                    <label class="col-md-7 col-form-label Labels" style="margin-top:0px;">
                                        Limpiar Dispositivos Confialbes (2FA):
                                    </label>
                                    <div class="col-md-5 text-left" style="padding-left:0px;">
                                        <input tabindex="12" type="checkbox" checked data-toggle="toggle" id="chkTrustedActivo">
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                </div>

                


            </div>
        </div>
        <div class="card-footer" style="margin-bottom: 10px;">
            <div class="row">
                <div class="col-md-6 text-left">
                    <button tabindex="1003" type="button" id="btnListaUsuarios"  style="border-radius: 0px 16px 0px 16px !important; " class="btn btn-buscar" title="Listado Usuarios"><span class="fas fa-users faa-ring animated"></span> Listado Usuarios</button>
                 </div>
                 <div class="col-md-6 text-right">
                 <button tabindex="1001" type="button" id="btnGrabar" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad" title="Guardar"><span class="fa ico_grabar faa-wrench animated"></span> Guardar</button>
                 <button tabindex="1002" type="button" id="btnLimpiar"  style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-limpiar" title="Nuevo"><span class="fa ico_limpiar faa-ring animated"></span> Nuevo</button>
               </div>
            </div>
        </div>
    </div>
</div>



@* Fin Grilla Roles  --------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------*@
<div class="card border-success hidden" id="pn_Roles">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fa fa-server text-white"></i>Asignar Roles</h4>
        <div class="card-actions ms-auto d-flex button-group">
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="row">
            <div class="col-md-3 MargFloatBoos">
                <div class="form-group has-float-label">
                    @Html.DropDownList("ddlRol", null, String.Format("Seleccione una opción"), htmlAttributes: new { @tabindex = 1, id = "ddlRol", @class = "form-control select2", style = "width: 80%;" })
                    <label class="Labels">Rol:</label>
                </div>
            </div>
            <div class="col-md-3 MargFloatBoos">
                <div class="form-group has-float-label">
                    <input tabindex="12" type="text" id="txtFechaFin" style="width:100%" placeholder="Fecha" class="Calendario" value="@ViewBag.FechaAd" />
                    <label class="Labels">Fecha Caducidad Rol:</label>
                </div>
            </div>
            <div class="col-md-6 MargFloatBoos">
                <div class="form-group has-float-label">
                    <input tabindex="13" type="text" id="txtJustificacion" name="txtJustificacion" placeholder="Justifique el permiso de acceso al sistema o cambios que realice con caso SIGMA" class="form-control" />
                    <label class="Labels">Justificación:</label>
                </div>
            </div>
        </div>
        <div class="card-footer" style="margin-bottom: 10px;">
            <div class="col-md-12 text-right">
                <button tabindex="14" type="button" id="btnGrabarRol"style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad"><span class="fa ico_grabar faa-wrench animated"></span> Guardar Rol</button>
            </div>
        </div>
    </div>
</div>



<div class="card border-success hidden" id="pn_Grilla">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fa fa-server text-white"></i>Roles Asignados al Funcionario(a)</h4>
        <div class="card-actions ms-auto d-flex button-group">
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="row">
            <div class="col-md-12">
                <div class="table-responsive m-t-40" style="margin-top: 0px !important;">
                    <table id="tbGrilla" class="table table-bordered table-striped" width="100%" style="margin-top: -1px !important;"></table>
                </div>
            </div>
        </div>
    </div>
</div>


@* Grilla para listado de usuarios----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@




<div class="card border-success hidden" id="pn_GrillaUsuarios">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fa fa-server text-white"></i>Listado de Usuarios</h4>
        <div class="card-actions ms-auto d-flex button-group">
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>
    <div class="card-body collapse show">
        <div class="row">
            <div class="col-md-12">
                <div class="table-responsive m-t-40" style="margin-top: 0px !important;">
                    <table id="tbGrillaUsuarios" class="table table-bordered table-striped" width="100%" style="margin-top: -1px !important;"></table>
                </div>
            </div>
        </div>
    </div>
</div>

