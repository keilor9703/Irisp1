@{
    ViewData["Title"] = "Uso y Auditoría";
}

@section styles {
    <style>
        .stat-card { display:flex; align-items:center; background:#fff; border-radius:10px; padding:14px;
                     height:100%; box-shadow:0 1px 4px rgba(0,0,0,.08); border-left:4px solid #ccc; }
        .stat-card.st-secondary{border-left-color:#6c757d;} .stat-card.st-success{border-left-color:#28a745;}
        .stat-card.st-warning{border-left-color:#ffc107;} .stat-card.st-danger{border-left-color:#dc3545;}
        .stat-card.st-info{border-left-color:#08a6cb;} .stat-card.st-primary{border-left-color:#0d6efd;}
        .stat-card .stat-icon{ width:44px;height:44px;min-width:44px;border-radius:50%;display:flex;
            align-items:center;justify-content:center;color:#fff;font-size:17px;margin-right:12px;}
        .stat-icon.bg-secondary{background:#6c757d;} .stat-icon.bg-success{background:#28a745;}
        .stat-icon.bg-warning{background:#ffc107;color:#212529;} .stat-icon.bg-danger{background:#dc3545;}
        .stat-icon.bg-info{background:#08a6cb;} .stat-icon.bg-primary{background:#0d6efd;}
        .stat-card .stat-body h3{margin:0;font-weight:700;font-size:1.35rem;line-height:1.2;color:#0f172a;}
        .stat-card .stat-body p{margin:0;color:#6c757d;font-size:.70rem;text-transform:uppercase;
            letter-spacing:.03em;font-weight:600;}
        .chart-box{position:relative;height:300px;}
    </style>
}

<div class="row">
    <div class="col-12">
        <div class="card border-info mb-3">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white mb-0"><i class="fas fa-chart-line mr-2 text-white"></i> Uso y Auditoría del Sistema</h4>
            </div>
            <div class="card-body">
                <div class="row align-items-end">
                    <div class="col-md-2 mb-2">
                        <label class="mb-1">Fecha inicio</label>
                        <input type="date" id="fAudIni" class="form-control form-control-sm" value="@ViewBag.FechaIni" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <label class="mb-1">Fecha fin</label>
                        <input type="date" id="fAudFin" class="form-control form-control-sm" value="@ViewBag.FechaFin" />
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="mb-1">Unidad</label>
                        <select id="fAudUnidad" class="form-control form-control-sm"><option value="">Todas</option></select>
                    </div>
                    <div class="col-md-3 mb-2">
                        <label class="mb-1">Usuario (cédula)</label>
                        <input type="number" id="fAudUsuario" class="form-control form-control-sm" placeholder="Opcional" />
                    </div>
                    <div class="col-md-2 mb-2">
                        <button id="btnAudConsultar" class="btn btn-info btn-block"><i class="fas fa-search"></i> Consultar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KPIs -->
<div class="row">
    <div class="col-md-4 col-xl-2 mb-3"><div class="stat-card st-primary"><div class="stat-icon bg-primary"><i class="fas fa-user-plus"></i></div><div class="stat-body"><h3 id="kpiCreados">0</h3><p>Usuarios creados</p></div></div></div>
    <div class="col-md-4 col-xl-2 mb-3"><div class="stat-card st-success"><div class="stat-icon bg-success"><i class="fas fa-user-check"></i></div><div class="stat-body"><h3 id="kpiActivos">0</h3><p>Han ingresado</p></div></div></div>
    <div class="col-md-4 col-xl-2 mb-3"><div class="stat-card st-danger"><div class="stat-icon bg-danger"><i class="fas fa-user-slash"></i></div><div class="stat-body"><h3 id="kpiNunca">0</h3><p>Nunca ingresaron</p></div></div></div>
    <div class="col-md-4 col-xl-2 mb-3"><div class="stat-card st-info"><div class="stat-icon bg-info"><i class="fas fa-percent"></i></div><div class="stat-body"><h3 id="kpiAdopcion">0%</h3><p>Adopción</p></div></div></div>
    <div class="col-md-4 col-xl-2 mb-3"><div class="stat-card st-secondary"><div class="stat-icon bg-secondary"><i class="fas fa-sign-in-alt"></i></div><div class="stat-body"><h3 id="kpiIngresos">0</h3><p>Ingresos (logins)</p></div></div></div>
    <div class="col-md-4 col-xl-2 mb-3"><div class="stat-card st-warning"><div class="stat-icon bg-warning"><i class="fas fa-th-large"></i></div><div class="stat-body"><h3 id="kpiModulos">0</h3><p>Módulos usados</p></div></div></div>
</div>

<!-- Gráficas -->
<div class="row">
    <div class="col-lg-8 mb-3">
        <div class="card border-info h-100"><div class="card-header"><h5 class="card-title text-white mb-0"><i class="fas fa-wave-square mr-2 text-white"></i>Actividad por fecha</h5></div>
            <div class="card-body"><div class="chart-box"><canvas id="graficoPorFecha"></canvas></div></div></div>
    </div>
    <div class="col-lg-4 mb-3">
        <div class="card border-info h-100"><div class="card-header"><h5 class="card-title text-white mb-0"><i class="fas fa-building mr-2 text-white"></i>Actividad por unidad</h5></div>
            <div class="card-body"><div class="chart-box"><canvas id="graficoPorUnidad"></canvas></div></div></div>
    </div>
</div>
<div class="row">
    <div class="col-lg-6 mb-3">
        <div class="card border-info h-100"><div class="card-header"><h5 class="card-title text-white mb-0"><i class="fas fa-th-large mr-2 text-white"></i>Uso por módulo / funcionalidad</h5></div>
            <div class="card-body"><div class="chart-box"><canvas id="graficoPorModulo"></canvas></div></div></div>
    </div>
    <div class="col-lg-6 mb-3">
        <div class="card border-info h-100"><div class="card-header"><h5 class="card-title text-white mb-0"><i class="fas fa-user-tie mr-2 text-white"></i>Funcionarios más activos</h5></div>
            <div class="card-body"><div class="chart-box"><canvas id="graficoTopUsuarios"></canvas></div></div></div>
    </div>
</div>

<!-- Depuración de usuarios -->
<div class="row">
    <div class="col-12 mb-3">
        <div class="card border-info">
            <div class="card-header"><h5 class="card-title text-white mb-0"><i class="fas fa-users-cog mr-2 text-white"></i>Depuración de usuarios (uso por funcionario)</h5></div>
            <div class="card-body">
                <p class="text-muted" style="font-size:.85rem;">Permite identificar usuarios/roles creados que no están usando el sistema, para depuración. "Nunca ingresó" o "Inactivo (+90 días)" son candidatos a revisión.</p>
                <div class="table-responsive">
                    <table id="tbDepuracion" class="table table-striped table-sm" style="width:100%"></table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/TemplateMonster_bt5/assets/libs/chart.js/dist/Chart.min.js"></script>
    <script src="~/areas/admin/DashboardUso.js" asp-append-version="true"></script>
}
