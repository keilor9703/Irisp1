@{
    ViewData["Title"] = "Control de Gestión";
}

@section styles {
    <style>
        .stat-card {
            display: flex;
            align-items: center;
            background: #fff;
            border-radius: 10px;
            padding: 16px;
            height: 100%;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            border-left: 4px solid #ccc;
        }
        .stat-card.st-secondary { border-left-color: #6c757d; }
        .stat-card.st-success   { border-left-color: #28a745; }
        .stat-card.st-warning   { border-left-color: #ffc107; }
        .stat-card.st-danger    { border-left-color: #dc3545; }
        .stat-card.st-info      { border-left-color: #08a6cb; }
        .stat-card .stat-icon {
            width: 46px;
            height: 46px;
            min-width: 46px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 18px;
            margin-right: 12px;
        }
        .stat-icon.bg-secondary { background: #6c757d; }
        .stat-icon.bg-success   { background: #28a745; }
        .stat-icon.bg-warning   { background: #ffc107; color: #212529; }
        .stat-icon.bg-danger    { background: #dc3545; }
        .stat-icon.bg-info      { background: #08a6cb; }
        .stat-card .stat-body h3 {
            margin: 0;
            font-weight: 700;
            font-size: 1.4rem;
            line-height: 1.2;
        }
        .stat-card .stat-body p {
            margin: 0;
            color: #6c757d;
            font-size: .72rem;
            text-transform: uppercase;
            letter-spacing: .03em;
            font-weight: 600;
        }
        .stat-card .stat-body small {
            display: block;
            color: #9aa0a6;
            font-size: .7rem;
        }
        #rangoFechasTablero {
            font-size: .85rem;
            color: #002a66;
            font-weight: bold;
        }

        /* KPI cards y elementos de gráficas son "drillables": doble click abre el detalle,
           igual que en una tabla dinámica de Excel. */
        .stat-card[data-kpi] {
            cursor: pointer;
            transition: box-shadow .15s ease, transform .15s ease;
        }
        .stat-card[data-kpi]:hover {
            box-shadow: 0 4px 10px rgba(0,0,0,.12);
            transform: translateY(-2px);
        }
        .drill-hint {
            font-size: .65rem;
            color: #adb5bd;
            margin-top: 2px;
        }
        canvas.drillable { cursor: pointer; }
        #tbEfectividadUnidad tbody tr { cursor: pointer; }

        /* Mismo ajuste que en Mapa.cshtml: el widget Kendo por defecto (píldora verdosa) no
           combina con el resto de campos .form-control del sistema. */
        .k-datepicker.k-widget { width: 100% !important; }
        .k-datepicker .k-picker-wrap {
            border: 1px solid #ccc !important;
            border-left: 5px solid #08a6cb !important;
            border-radius: 4px !important;
            background: #fff !important;
            box-shadow: none !important;
            height: 34px !important;
        }
        .k-datepicker .k-picker-wrap.k-state-focused {
            border-color: #cacd3a !important;
            border-left: 5px solid #f18f08 !important;
        }
        .k-datepicker .k-picker-wrap .k-input {
            height: 32px !important;
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding-top: 6px !important;
            font-size: 14px !important;
        }
        .k-datepicker .k-picker-wrap .k-select {
            background: transparent !important;
            border: none !important;
            border-left: 1px solid #eee !important;
        }
    </style>
}

@section scripts {
    <script src="~/TemplateMonster_bt5/assets/libs/chart.js/dist/Chart.min.js"></script>
    <script>
        var UrlGetTareasControlGestion = "@Url.Action("F_GetTareasControlGestion", "ControlGestion", new { Area = "Control" })";
        var UrlGetKpisTiempoGestion = "@Url.Action("F_GetKpisTiempoGestion", "ControlGestion", new { Area = "Control" })";
        var UrlGetResultadosCasos = "@Url.Action("F_GetResultadosCasos", "ControlGestion", new { Area = "Control" })";
        var UrlGetSiglasUnidad = "@Url.Action("F_GetSiglasUnidad", "ControlGestion", new { Area = "Control" })";
    </script>
    <script src="~/Areas/Control/ControlGestion.js"></script>
}

<section class="content-header"></section>
<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span> Inicio </span></a></li>
            <li class="active">Control de Gestión / Tablero de tiempos y SLA @(!string.IsNullOrWhiteSpace(ViewBag.Unidad as string) ? " - " + ViewBag.Unidad : "")</li>
        </ul>
    </div>
</div>

<div class="row align-items-end">
    <div class="col-md-2 MargFloatBoos">
        <div class="form-group has-float-label">
            <input type="text" id="txtFechaInicioTablero" style="width:100%" class="Calendario form-control InputPading" placeholder=" " />
            <label class="Labels">Fecha inicio</label>
        </div>
    </div>
    <div class="col-md-2 MargFloatBoos">
        <div class="form-group has-float-label">
            <input type="text" id="txtFechaFinTablero" style="width:100%" class="Calendario form-control InputPading" placeholder=" " />
            <label class="Labels">Fecha fin</label>
        </div>
    </div>
    <div class="col-md-2 MargFloatBoos">
        <div class="form-group has-float-label">
            @Html.DropDownList("ddlRegion", null, String.Format("Todas las regiones"),
                     htmlAttributes: new { id = "ddlRegion", @class = "form-control select2", style = "width: 100%;" })
            <label class="Labels">Región</label>
        </div>
    </div>
    <div class="col-md-2 MargFloatBoos">
        <div class="form-group has-float-label">
            @Html.DropDownList("ddlSiglaUnidad", null, String.Format("Todas las unidades"),
                     htmlAttributes: new { id = "ddlSiglaUnidad", @class = "form-control select2", style = "width: 100%;" })
            <label class="Labels">Sigla de unidad</label>
        </div>
    </div>
    <div class="col-md-2 MargFloatBoos">
        <button type="button" id="btnAplicarFiltroTablero" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad">
            <i class="fas fa-filter"></i> Aplicar
        </button>
    </div>
    <div class="col-md-2 MargFloatBoos text-right">
        <a href="@Url.Action("Mapa", "ControlGestion", new { Area = "Control" })" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-buscar">
            <i class="fas fa-map-marked-alt"></i> Ver mapa
        </a>
    </div>
</div>
<div class="row">
    <div class="col-md-12 MargFloatBoos">
        <span id="rangoFechasTablero"></span>
    </div>
</div>

<h6 class="text-muted mb-2"><i class="fas fa-tasks"></i> Cumplimiento de SLA por tarea
    <span class="drill-hint"><i class="fas fa-mouse-pointer"></i> doble click en una tarjeta o gráfica para ver el detalle</span>
</h6>
<div class="row mb-3">
    <div class="col-md-2 mb-3">
        <div class="stat-card st-secondary" data-kpi="tareas-total">
            <div class="stat-icon bg-secondary"><i class="fas fa-list"></i></div>
            <div class="stat-body">
                <h3 id="kpiTotal">0</h3>
                <p>Total tareas</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card st-success" data-kpi="tareas-atiempo">
            <div class="stat-icon bg-success"><i class="fas fa-check"></i></div>
            <div class="stat-body">
                <h3 id="kpiATiempo">0</h3>
                <p>A tiempo</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card st-warning" data-kpi="tareas-enriesgo">
            <div class="stat-icon bg-warning"><i class="fas fa-exclamation-triangle"></i></div>
            <div class="stat-body">
                <h3 id="kpiEnRiesgo">0</h3>
                <p>En riesgo</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card st-danger" data-kpi="tareas-vencido">
            <div class="stat-icon bg-danger"><i class="fas fa-times"></i></div>
            <div class="stat-body">
                <h3 id="kpiVencido">0</h3>
                <p>Vencidas</p>
            </div>
        </div>
    </div>
    <div class="col-md-2 mb-3">
        <div class="stat-card st-secondary" data-kpi="tareas-sinsla">
            <div class="stat-icon bg-secondary"><i class="fas fa-question"></i></div>
            <div class="stat-body">
                <h3 id="kpiSinSla">0</h3>
                <p>Sin SLA definido</p>
            </div>
        </div>
    </div>
</div>

<h6 class="text-muted mb-2"><i class="fas fa-stopwatch"></i> Tiempo de gestión por caso IRISP1</h6>
<div class="row mb-3">
    <div class="col-md-4 mb-3">
        <div class="stat-card st-info" data-kpi="casos-tiempototal">
            <div class="stat-icon bg-info"><i class="fas fa-flag-checkered"></i></div>
            <div class="stat-body">
                <h3 id="kpiTiempoTotalCaso">-</h3>
                <p>Tiempo total (creación a finalización)</p>
                <small id="kpiTiempoTotalCasoSub"></small>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card st-info" data-kpi="casos-verificacion">
            <div class="stat-icon bg-info"><i class="fas fa-search"></i></div>
            <div class="stat-body">
                <h3 id="kpiTiempoVerificacion">-</h3>
                <p>Tiempo promedio — Verificación</p>
                <small id="kpiTiempoVerificacionSub"></small>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="stat-card st-info" data-kpi="casos-investigacion">
            <div class="stat-icon bg-info"><i class="fas fa-user-secret"></i></div>
            <div class="stat-body">
                <h3 id="kpiTiempoInvestigacion">-</h3>
                <p>Tiempo promedio — Investigación</p>
                <small id="kpiTiempoInvestigacionSub"></small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card border-info">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="mr-2 fas fa-chart-bar text-white"></i> Promedio de tiempo por unidad</h4>
            </div>
            <div class="card-body">
                <div style="position:relative; height:320px;">
                    <canvas id="graficoPromedioUnidad" class="drillable"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<h6 class="text-muted mb-2"><i class="fas fa-bullseye"></i> Resultados y efectividad de las unidades</h6>
<div class="row mb-3">
    <div class="col-md mb-3">
        <div class="stat-card st-success" data-kpi="resultados-finalizados">
            <div class="stat-icon bg-success"><i class="fas fa-flag-checkered"></i></div>
            <div class="stat-body">
                <h3 id="kpiCasosFinalizados">0</h3>
                <p>Finalizados</p>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="stat-card st-success" data-kpi="resultados-existe">
            <div class="stat-icon bg-success"><i class="fas fa-check-double"></i></div>
            <div class="stat-body">
                <h3 id="kpiCasosExiste">0</h3>
                <p>Existencia confirmada</p>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="stat-card st-danger" data-kpi="resultados-noexiste">
            <div class="stat-icon bg-danger"><i class="fas fa-ban"></i></div>
            <div class="stat-body">
                <h3 id="kpiCasosNoExiste">0</h3>
                <p>No existe</p>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="stat-card st-warning" data-kpi="resultados-inconclusos">
            <div class="stat-icon bg-warning"><i class="fas fa-question-circle"></i></div>
            <div class="stat-body">
                <h3 id="kpiCasosInconclusos">0</h3>
                <p>Inconclusos</p>
                <small>Finalizados sin existencia definida</small>
            </div>
        </div>
    </div>
    <div class="col-md mb-3">
        <div class="stat-card st-secondary" data-kpi="resultados-abiertos">
            <div class="stat-icon bg-secondary"><i class="fas fa-folder-open"></i></div>
            <div class="stat-body">
                <h3 id="kpiCasosAbiertos">0</h3>
                <p>Abiertos (en trámite)</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-5 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="mr-2 fas fa-chart-pie text-white"></i> Resultado de existencia</h4>
            </div>
            <div class="card-body d-flex flex-column">
                <div style="position:relative; height:280px;">
                    <canvas id="graficoResultadoExistencia" class="drillable"></canvas>
                </div>
                <div id="leyendaResultadoExistencia" class="mt-2"></div>
            </div>
        </div>
    </div>
    <div class="col-md-7 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="mr-2 fas fa-medal text-white"></i> Efectividad por unidad</h4>
            </div>
            <div class="card-body">
                <p class="text-muted" style="font-size:.8rem;">
                    % de casos asignados a la unidad que terminaron con existencia confirmada — permite ver
                    qué unidades sí están tramitando lo que se les asigna. Doble click en una fila para ver el detalle.
                </p>
                <div class="table-responsive">
                    <table id="tbEfectividadUnidad" class="table table-bordered table-striped" width="100%"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="mr-2 fas fa-arrow-up text-white"></i> Top 10 unidades con más casos registrados</h4>
            </div>
            <div class="card-body">
                <div style="position:relative; height:320px;">
                    <canvas id="graficoTopMasCasos" class="drillable"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="mr-2 fas fa-arrow-down text-white"></i> Top 10 unidades con menos casos registrados</h4>
            </div>
            <div class="card-body">
                <div style="position:relative; height:320px;">
                    <canvas id="graficoTopMenosCasos" class="drillable"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12 mb-3">
        <div class="card border-info">
            <div class="card-header d-flex align-items-center">
                <h4 class="card-title text-white"><i class="mr-2 fas fa-stream text-white"></i> Casos por estado general</h4>
            </div>
            <div class="card-body">
                <div style="position:relative; height:280px;">
                    <canvas id="graficoPorEstado" class="drillable"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-info">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fas fa-clipboard-list text-white"></i> Tareas y estado de SLA</h4>
    </div>
    <div class="card-body">
        <div class="table-responsive m-t-40" style="margin-top: 0px !important;">
            <table id="tbTareasControlGestion" class="table table-bordered table-striped" width="100%" style="margin-top: -1px !important;"></table>
        </div>
    </div>
</div>

@* Modal de detalle (drill-down): se abre con doble click sobre cualquier tarjeta KPI, barra de
   gráfica, porción de la torta o fila de la tabla de efectividad — igual que el detalle de una
   tabla dinámica de Excel. *@
<div class="modal fade" id="ModalDetalleRegistros" tabindex="-1" aria-labelledby="ModalDetalleRegistrosLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h5 class="modal-title" id="ModalDetalleRegistrosLabel"><i class="mr-2 fas fa-list-ul"></i> Detalle de registros</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted" id="ModalDetalleRegistrosSubtitulo" style="font-size:.85rem;"></p>
                <div class="table-responsive">
                    <table id="tbDetalleRegistros" class="table table-bordered table-striped" width="100%"></table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>
