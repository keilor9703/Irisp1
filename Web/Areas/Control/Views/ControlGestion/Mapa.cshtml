@{
    ViewData["Title"] = "Mapa de casos IRISP1";
}

@section styles {
    <link rel="stylesheet" href="~/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/lib/leaflet/MarkerCluster.css" />
    <link rel="stylesheet" href="~/lib/leaflet/MarkerCluster.Default.css" />
    <style>
        #mapaIrisp1 {
            width: 100%;
            height: 720px;
            border-radius: 8px;
            border: 1px solid #ccc;
        }
        /* Leyenda de colores de los puntos por resultado de existencia */
        .leyenda-mapa {
            background: rgba(255,255,255,.9);
            padding: 8px 10px;
            border-radius: 6px;
            box-shadow: 0 1px 4px rgba(0,0,0,.3);
            font-size: .75rem;
            line-height: 1.5;
        }
        .leyenda-mapa .punto {
            display: inline-block; width: 11px; height: 11px; border-radius: 50%;
            margin-right: 6px; vertical-align: middle;
        }
        .seccion-titulo-mapa { color: #000; font-weight: 600; }
        /* site.css fuerza ".btn { color: white !important; }" en todos los botones — en un
           btn-outline-secondary sin seleccionar eso deja texto blanco sobre fondo claro
           (invisible). Se fuerza el color de vuelta solo para estos botones de modo. */
        .btn-modo-mapa {
            color: #495057 !important;
            background: #fff;
            border-color: #6c757d;
        }
        .btn-modo-mapa.active {
            background: linear-gradient(90deg, #cdff00, #08a6cb) !important;
            border-color: #08a6cb;
            color: #151b3b !important;
        }

        /* El widget Kendo (fondo verdoso, forma de píldora) no combina con el resto de campos
           .form-control del sistema (gris, borde izquierdo de color, 34px de alto). Se le da la
           misma apariencia para que "Fecha inicio/fin" luzcan igual que "Sigla de unidad". */
        .k-datepicker.k-widget {
            width: 100% !important;
        }
        .k-datepicker .k-picker-wrap {
            border: 1px solid #ccc !important;
            border-left: 5px solid #08a6cb !important;
            border-radius: 4px !important;
            background: #fff !important;
            box-shadow: none !important;
            height: 34px !important;
        }
        .k-datepicker .k-picker-wrap.k-state-focused {
            border-color: #cacd3a !important;
            border-left: 5px solid #f18f08 !important;
        }
        .k-datepicker .k-picker-wrap .k-input {
            height: 32px !important;
            border: none !important;
            box-shadow: none !important;
            background: transparent !important;
            padding-top: 6px !important;
            font-size: 14px !important;
        }
        .k-datepicker .k-picker-wrap .k-select {
            background: transparent !important;
            border: none !important;
            border-left: 1px solid #eee !important;
        }
        .mapa-stat {
            background: #fff;
            border-radius: 10px;
            padding: 14px;
            box-shadow: 0 1px 4px rgba(0,0,0,.08);
            text-align: center;
        }
        .mapa-stat h3 { margin: 0; font-weight: 700; color: #002a66; }
        .mapa-stat p { margin: 0; font-size: .72rem; text-transform: uppercase; color: #6c757d; font-weight: 600; }
    </style>
}

@section scripts {
    <script src="~/lib/leaflet/leaflet.js"></script>
    <script src="~/lib/leaflet/leaflet.markercluster.js"></script>
    <script src="~/lib/leaflet/leaflet-heat.js"></script>
    <script src="~/TemplateMonster_bt5/assets/libs/chart.js/dist/Chart.min.js"></script>
    <script>
        var UrlGetMapaIrisp1 = "@Url.Action("F_GetMapaIrisp1", "ControlGestion", new { Area = "Control" })";
        var UrlGetSiglasUnidad = "@Url.Action("F_GetSiglasUnidad", "ControlGestion", new { Area = "Control" })";
    </script>
    <script src="~/Areas/Control/MapaIrisp1.js"></script>
}

<section class="content-header"></section>
<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span> Inicio </span></a></li>
            <li><a href="@Url.Action("Tablero", "ControlGestion", new { Area = "Control" })">Control de Gestión</a></li>
            <li class="active">Mapa de casos IRISP1 @(!string.IsNullOrWhiteSpace(ViewBag.Unidad as string) ? " - " + ViewBag.Unidad : "")</li>
        </ul>
    </div>
</div>

<div class="card border-info">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="mr-2 fas fa-map-marked-alt text-white"></i> Focalización geográfica de casos IRISP1</h4>
    </div>
    <div class="card-body">
        @if (ViewBag.SiglasCargadasError == true)
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                No fue posible cargar el catálogo de unidades/regiones (columna SIGLA_UNIDAD de IRISP_CRIMINALIDAD).
                Verifique que el script <code>Oracle/PK_CONTROL_GESTION_IRIS.txt</code> esté actualizado en la
                base de datos (funciones <code>F_GetSiglasUnidadIrisp1</code>, <code>F_GetRegionesIrisp1</code>,
                <code>F_GetMapaIrisp1</code>, <code>F_GetCasosControlGestion</code>), o que existan casos con datos de unidad.
            </div>
        }
        <div class="row align-items-end">
            <div class="col-md-2 MargFloatBoos">
                <div class="form-group has-float-label">
                    <input type="text" id="txtFechaInicioMapa" style="width:100%" class="Calendario form-control InputPading" placeholder=" " />
                    <label class="Labels">Fecha inicio</label>
                </div>
            </div>
            <div class="col-md-2 MargFloatBoos">
                <div class="form-group has-float-label">
                    <input type="text" id="txtFechaFinMapa" style="width:100%" class="Calendario form-control InputPading" placeholder=" " />
                    <label class="Labels">Fecha fin</label>
                </div>
            </div>
            <div class="col-md-2 MargFloatBoos">
                <div class="form-group has-float-label">
                    @Html.DropDownList("ddlRegion", null, String.Format("Todas las regiones"),
                             htmlAttributes: new { id = "ddlRegion", @class = "form-control select2", style = "width: 100%;" })
                    <label class="Labels">Región</label>
                </div>
            </div>
            <div class="col-md-2 MargFloatBoos">
                <div class="form-group has-float-label">
                    @Html.DropDownList("ddlSiglaUnidad", null, String.Format("Todas las unidades"),
                             htmlAttributes: new { id = "ddlSiglaUnidad", @class = "form-control select2", style = "width: 100%;" })
                    <label class="Labels">Sigla de unidad</label>
                </div>
            </div>
            <div class="col-md-2 MargFloatBoos">
                <div class="form-group has-float-label">
                    <select id="ddlExistencia" class="form-control select2" style="width:100%;">
                        <option value="">Todos los resultados</option>
                        <option value="existe">Existe confirmado</option>
                        <option value="noexiste">No existe</option>
                        <option value="sindeterminar">Sin determinar</option>
                    </select>
                    <label class="Labels">Resultado de existencia</label>
                </div>
            </div>
            <div class="col-md-3 MargFloatBoos">
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-secondary btn-modo-mapa active" data-modo="puntos"><i class="fas fa-map-pin"></i> Puntos</button>
                    <button type="button" class="btn btn-outline-secondary btn-modo-mapa" data-modo="cluster"><i class="fas fa-layer-group"></i> Cluster</button>
                    <button type="button" class="btn btn-outline-secondary btn-modo-mapa" data-modo="calor"><i class="fas fa-fire"></i> Calor</button>
                </div>
            </div>
            <div class="col-md-3 MargFloatBoos text-right">
                <button type="button" id="btnAplicarFiltroMapa" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad">
                    <i class="fas fa-filter"></i> Aplicar
                </button>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-2 mb-2"><div class="mapa-stat"><h3 id="mapaKpiTotal">0</h3><p>Casos georreferenciados</p></div></div>
            <div class="col-md-2 mb-2"><div class="mapa-stat"><h3 id="mapaKpiExiste" style="color:#28a745;">0</h3><p>Existencia confirmada</p></div></div>
            <div class="col-md-2 mb-2"><div class="mapa-stat"><h3 id="mapaKpiUnidades">0</h3><p>Unidades distintas</p></div></div>
            <div class="col-md-2 mb-2"><div class="mapa-stat"><h3 id="mapaKpiMunicipios">0</h3><p>Municipios distintos</p></div></div>
            <div class="col-md-4 mb-2"><div class="mapa-stat"><h3 id="mapaKpiDelito" style="font-size:1rem;">-</h3><p>Delito más frecuente</p></div></div>
        </div>

        <div id="mapaAvisoSinDatos" class="alert alert-info" style="display:none;">
            <i class="fas fa-info-circle"></i> <span id="mapaAvisoSinDatosTexto"></span>
        </div>

        <div id="mapaIrisp1"></div>
    </div>
</div>

<h6 class="seccion-titulo-mapa mb-2 mt-2"><i class="fas fa-chart-bar"></i> Análisis del conjunto de casos mostrado en el mapa</h6>
<div class="row">
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center py-2">
                <h6 class="card-title text-white mb-0"><i class="mr-2 fas fa-chart-pie text-white"></i> Resultado de existencia</h6>
            </div>
            <div class="card-body p-2">
                <div style="position:relative; height:230px;">
                    <canvas id="graficoMapaExistencia"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center py-2">
                <h6 class="card-title text-white mb-0"><i class="mr-2 fas fa-city text-white"></i> Top 10 municipios</h6>
            </div>
            <div class="card-body p-2">
                <div style="position:relative; height:230px;">
                    <canvas id="graficoMapaMunicipios"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center py-2">
                <h6 class="card-title text-white mb-0"><i class="mr-2 fas fa-calendar-week text-white"></i> Casos por día de la semana</h6>
            </div>
            <div class="card-body p-2">
                <div style="position:relative; height:230px;">
                    <canvas id="graficoPorDiaSemana"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card border-info h-100">
            <div class="card-header d-flex align-items-center py-2">
                <h6 class="card-title text-white mb-0"><i class="mr-2 fas fa-clock text-white"></i> Casos por hora del día</h6>
            </div>
            <div class="card-body p-2">
                <div style="position:relative; height:230px;">
                    <canvas id="graficoPorHora"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>
