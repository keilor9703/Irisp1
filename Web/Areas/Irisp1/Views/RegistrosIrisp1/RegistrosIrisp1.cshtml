                                @Html.DropDownList("ddlActividad", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlActividad", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Tiempo actividad delito :</label>
                            </div>
                        </div>

                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlFuente", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlFuente", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Fuente:</label>
                            </div>
                        </div>

                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlEntono", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlEntono", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Entorno:</label>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtCampoT" name="txtCampoT" type="text" value="" autocomplete="off" placeholder="Describa en el entorno" class="form-control InputPading">
                                <label class="Labels">Nombre del entorno afectado:</label>
                            </div>
                        </div>
                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlZona", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlZona", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Zona:</label>
                            </div>
                        </div>
                        <div class="col-md-12 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <textarea tabindex="400" class="form-control" placeholder=" " rows="5" id="txtObservaCabezaCuello" name="txtObservaCabezaCuello" maxlength="4000" cols="40" style="height: 50px !important; text-align:justify; margin-bottom: 0px;"></textarea>
                                <label class="Labels">Descripcion General:</label>
                            </div>
                        </div>
                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-horizontal">
                                <div class="form-group row" style="margin-bottom: 0px;">
                                    <label class="col-md-6 col-form-label Labels" style="margin-top:0px;">Registro fotografico?:</label>
                                    <div class="col-md-4 text-left" style="padding-left:0px;">
                                        <input tabindex="111" type="checkbox" checked data-toggle="toggle" id="chkDesignado">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group has-float-label">
                                <div class="input-group">
                                    <input tabindex="12" name="txtIdentificacionK" type="text" id="txtIdentificacionK" autocomplete="off" placeholder=" " class="form-control InputPading" />
                                    <span class="input-group-btn">
                                        <button tabindex="31" class="btn btn-success" id="btnGetAtencionAmbIden" onclick="GetAtencionAmbIden(); return false;" style="height:34px; border-radius: 0px 0px 0px 0px !important;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                        <button tabindex="3" class="btn btn-warning" id="btnLimpiarAtencionAmbulatoriaA" onclick="LimpiarAtencionAmbulatoria(); return false;" style="height:34px; border-radius: 0px 5px 5px 0px !important; margin-left: -5px;" type="button" title="Limpiar Consulta"><b><i class="fa fa-eraser"></i></b></button>
                                    </span>
                                </div>
                                <label class="Labels">Anexo fotografico:</label>
                            </div>
                        </div>
                    </div>
                </fieldset>
                @* FIN  DATOS IRIS P1-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@

                @*   DATOS INTEGRANTES------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@
