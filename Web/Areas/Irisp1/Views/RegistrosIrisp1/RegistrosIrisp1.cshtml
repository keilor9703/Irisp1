                                    <button tabindex="2" class="btn btn-success" id="btnConsultarEmpl" onclick="F_GetFuncionariosIris ($('#txtIdentificacion').val()); return false;" style="height:34px; border-radius: 0px 0px 0px 0px !important;" type="button" title="Buscar..."><b><i class="fas fa-search"></i></b></button>
                                    
                                </span>
                                </div>
                                <label class="Labels">Identificación</label>
                            </div>
                        </div>
                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="5" name="txtFuncionario" type="text" id="txtFuncionario" autocomplete="off" placeholder=" " class="form-control InputPading"  readonly/>
                                <label class="Labels">Funcionario:</label>
                            </div>
                        </div>
                        <div class="col-md-5 MargFloatBoos">
                            <div class="form-group has-float-label">
                            <input tabindex="5" name="txtUnidad" type="text" id="txtUnidad" autocomplete="off" placeholder=" " class="form-control InputPading"  readonly/>
                            <label class="Labels">Unidad:</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-3 MargFloatBoos hidden">
                               <div class="form-group has-float-label">
                                    <input tabindex="5" name="txtDependencia" type="text" id="txtDependencia" autocomplete="off" placeholder=" " class="form-control InputPading"  readonly/>
                                    <label class="Labels">txtDependencia:</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlCuadrante", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlCuadrante", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Cuadrante:</label>
                            </div>
                        </div>
                        <div class="col-md-2 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtTelefono" name="txtTelefono" type="number" value="" autocomplete="off" placeholder="Digite # de teléfono" class="form-control InputPading">
                                <label class="Labels">Celular:</label>
                            </div>
                        </div>
                        <div class="col-md-2 MargFloatBoos">
                            
                            <div class="form-group has-float-label">
                                    <input tabindex="5" name="txtEspecialidad" type="text" id="txtEspecialidad" autocomplete="off" placeholder=" " class="form-control InputPading"  readonly/>
                                    <label class="Labels">Especialidad</label>
                                
                            </div>
                        </div>
                    </div >
                </fieldset>
                @* FIN  DATOS DEL FUNCIONARIO------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@

                @*   DATOS IRIS P1-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@
                <fieldset class="mt-3">
                    <legend style="width: calc(6.5em + .75rem + 2px) !important;">Datos IRIS P1</legend>
                    <div class="row">
                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlClase", new List<SelectListItem> { new SelectListItem { Text = "Seleccione", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlClase", @class = "form-control select2", style = "width: 100%;" })
