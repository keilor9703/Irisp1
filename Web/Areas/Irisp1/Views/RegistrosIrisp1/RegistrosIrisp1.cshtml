                <button tabindex="1002" id="btnLimpiar" onclick="AbrirModalNuevoIris();" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-limpiar" title="Nuevo">
                    <span class="fa ico_limpiar faa-ring animated"></span> Nuevo IRIS
                </button>
            </div>
        </div>
     </div>
</div>

