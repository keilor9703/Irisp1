                                new SelectListItem { Text = "Seleccione", Value = "0" },
                                new SelectListItem { Text = "Opción 1", Value = "1" },
                                new SelectListItem { Text = "Opción 2", Value = "2" }
                                },
                                                  htmlAttributes: new { @tabindex = 5, @id = "ddlNomClase1", @class = "form-control select2", style = "width: 100%;" })
