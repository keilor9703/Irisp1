                @*   DATOS IRIS P1-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@
                @*  <hr class="my-3" style="border-top: 1px dashed #adb5bd;"> *@
                <fieldset class="mt-3">

                    <legend style="width: calc(10em + .75rem + 2px) !important;">Datos IRIS P1</legend>
                    <div class="row">

                        <div class="col-md-3 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlClase", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 5, id = "ddlClase", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Clase:</label>
                            </div>
                        </div>

                        @* para clase = Trafico de estupefancientes *@
                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtNombreTrafico" name="txtNombreTrafico" type="text" value="" autocomplete="off" placeholder="Nombre, si aplica" class="form-control InputPading">
                                <label class="Labels">Nombre</label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos hidden">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlModExpendio", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 6, id = "ddlModExpendio", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Modalidad Expendio:</label>
                            </div>
                        </div>

                           @* para clase = Estructura*@
                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtNombreEstructura" name="txtNombreEstructura" type="text" value="" autocomplete="off" placeholder="digite el nombre de la estructura" class="form-control InputPading">
                                <label class="Labels">Nombre Estructura:</label>
                            </div>
                        </div>


                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtCantidadEstructura" name="txtCantidadEstructura" type="text" value="" autocomplete="off" placeholder="Digite la cantidad" class="form-control InputPading">
                                <label class="Labels">Cantidad:</label>
                            </div>
                        </div>


                            @* para clase = Instalación Fija*@
                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtNombreInstalacion" name="txtNombreInstalacion" type="text" value="" autocomplete="off" placeholder="Razón social de la instalación, si aplica" class="form-control InputPading">
                                <label class="Labels">Nombre Instalación:</label>
                            </div>
                        </div>


                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtCantidadInstalacion" name="txtCantidadInstalacion" type="text" value="" autocomplete="off" placeholder="Digite la cantidad" class="form-control InputPading">
                                <label class="Labels">Cantidad:</label>
                            </div>
                        </div>
                        
                        
                            @* para clase = Persona*@
                       
                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtCantidadPersonas" name="txtCantidadPersonas" type="text" value="" autocomplete="off" placeholder="Digite la cantidad de personas" class="form-control InputPading">
                                <label class="Labels">Cantidad:</label>
                            </div>
                        </div>

                        
                            @* para clase = Narcotrafico*@
                        <div class="col-md-3 hidden">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtNombreNarcotrafico" name="txtNombreNarcotrafico" type="text" value="" autocomplete="off" placeholder="Digite el nombre" class="form-control InputPading">
                                <label class="Labels">Nombre: </label>
                            </div>
                        </div>

                        <div class="col-md-4 MargFloatBoos hidden">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlClasiNarcotrafico", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlClasiNarcotrafico", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Clasificación Narcotráfico:</label>
                            </div>
                        </div>

                    </div>
                       
                     @* Demás campos *@
                    <div class="row">
                       
                        <div class="col-md-2 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlActividad", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlActividad", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Tiempo actividad:</label>
                            </div>
                        </div>

                        <div class="col-md-2 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlFuente", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlFuente", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Fuente:</label>
                            </div>
                        </div>

                        
                        <div class="col-md-2 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlEntono", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlEntono", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Entorno:</label>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group has-float-label">
                                <input tabindex="2" id="txtNombreEntornoAfectado" name="txtNombreEntornoAfectado" type="text" value="" autocomplete="off" placeholder="Nombre" class="form-control InputPading">
                                <label class="Labels">Nombre del entorno afectado:</label>
                            </div>
                        </div>

                         <div class="col-md-2 MargFloatBoos">
                            <div class="form-group has-float-label">
                                @Html.DropDownList("ddlZona", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlZona", @class = "form-control select2", style = "width: 100%;" })
                                <label class="Labels">Zona:</label>
                            </div>
                        </div>


                        <div class="col-md-12 MargFloatBoos">
                            <div class="form-group has-float-label">
                                <textarea tabindex="400" class="form-control" placeholder="Digite una descripción corta y diciente las caracteristicas de las personas o inmuebles y la forma como delinquen (Max 2000 caracteres) " rows="5" id="txtCaractGenerales" name="txtCaractGenerales" maxlength="4000" cols="40" style="height: 50px !important; text-align:justify; margin-bottom: 0px;"></textarea>
                                <label class="Labels">Descripcion General:</label>
                            </div>
                        </div>
                        <div class="col-md-4 MargFloatBoos">
                            <div class="form-horizontal">
                                <div class="form-group row" style="margin-bottom: 0px;">
                                    <label class="col-md-6 col-form-label Labels" style="margin-top:0px;">Registro fotografico?</label>
                                    <div class="col-md-4 text-left" style="padding-left:0px;">
                                        <input tabindex="111" type="checkbox" checked data-toggle="toggle" id="chkRegFoto">
                                    </div>
                                </div>
                            </div>
                        </div>

                          <div class="col-md-4" id="fotografia">
                                    <div class="form-group has-float-label">

                                        <label class="Labels" style="margin-left: 30px;">Anexo fotográfico:</label>


                                        <div class="input-group">

                                            <div class="input-group-append">
                                                <button tabindex="330"
                                                        class="btn btn-success"
                                                        id="btnSubirFoto"
                                                        onclick="document.getElementById('fileAnexoFotografico').click();"
                                                        type="button"
                                                        style="border-radius: 0px;"
                                                        title="Subir Foto">
                                                    <b><i class="fas fa-folder-open"></i></b>
                                                </button>
                                            </div>

                                            <!-- Campo para mostrar el nombre del archivo -->
                                            <input type="text"
                                                   id="nombreArchivo"
                                                   class="form-control"
                                                   onclick="document.getElementById('fileAnexoFotografico').click();"
                                                   placeholder="Ningún archivo seleccionado"
                                                   readonly
                                                   style="background-color: #fff;" />

                                            <!-- Botón para subir archivo -->
                                            <div class="input-group-append">
                                                <button tabindex="31"
                                                        class="btn btn-success"
                                                        id="btnSubirFoto"
                                                        onclick="SubirFoto();"
                                                        type="button"
                                                        style="border-radius: 0px;"
                                                        title="Subir Foto">
                                                    <b><i class="fas fa-upload"></i></b>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Input real oculto -->
                                        <input type="file"
                                               id="fileAnexoFotografico"
                                               name="fileAnexoFotografico"
                                               accept=".jpg,.jpeg,.png"
                                               style="display: none;"
                                               onchange="mostrarNombreArchivo(this)" />
                                    </div>

                                    <div id="estadoFoto" class="mt-2 text-success" style="display: none;">
                                        <i class="fas fa-check-circle"></i> Imagen guardada exitosamente.
                                    </div>
                           </div>

                        

                    </div>
                </fieldset>
                @* FIN  DATOS IRIS P1-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@

                @*   DATOS INTEGRANTES------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- *@
                <fieldset class="mt-3">
                    <legend style="width: calc(14em + .75rem + 2px) !important;">Datos de Integrantes</legend>
                    <div class="row">
                        <div class="col-md-2 MargFloatBoos">
