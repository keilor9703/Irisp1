<!-- INICIO DE MODAL DETALLE IRIS-->

<div class="modal fade" id="Modal_DetalleIris" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 80%;">

         <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel" style="font-weight: bold;">Detalle Iris - P1 / <span class="ms-2">   <strong>Criminalidad:</strong> <span id="txtClaseHeader"></span>  - <strong id="txtNombreClaseHeader"></strong></span></h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

               <input type="text" id="txtCriminalidadIdModal" class="d-none" value="@ViewBag.txtCriminalidadIdModal" />


                <div class="container-fluid">
                    <!-- Encabezado -->
                    <div class="row text-white p-2" style="background-color: #006837; border-radius: 5px;">
                        <div class="col-12">
                          
                            <strong id="txtUnidadDetalle"></strong> -  <strong> Fecha de creación: </strong> <span id="txtFechaCreacion"></span>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <!-- Columna 1: Aspecto Criminalidad -->
                        <div class="col-md-4">
                            <h6 class="fw-bold">ASPECTO CRIMINALIDAD</h6>
                            <p><strong></strong> 
                            <p><strong>Codigo IRISPI:</strong> <span id="txtCodigoIrispi"></span></p>
                            <p><strong>Clase:</strong> <span id="txtClaseDetalle"></span></p>
                            <p><strong>Nombre Clase:</strong> <span id="txtNombreClaseDetalle"></span></p>
                            <p><strong>Cantidad:</strong> <span id="txtCantidadDetalle"></span></p>
                            <p><strong>Fuente:</strong> <span id="txtFuente"></span></p>
                            <p><strong>Fecha inicio Existencia:</strong> <span id="txtFechaInicio"></span></p>
                         
                        </div>

                        <!-- Columna 2: Funcionario que informa -->
                        <div class="col-md-4">
                            <h6 class="fw-bold">FUNCIONARIO QUE INFORMA:</h6>
                           <p><strong></strong> 
                           @*  <button id="btnVisualizarFuncionario" class="btn btn-primary btn-sm mb-2">Visualizar</button> *@
                            <p><strong>Funcionario:</strong> <span id="txtFuncionarioDetalle"></span></p>
                            <p><strong>Unidad:</strong> <span id="txtUnidadDetalle2"></span></p>
                            <p><strong>Correo:</strong> <span id="txtCorreo"></span></p>
                            <p><strong>Celular SIATH:</strong> <span id="txtCelularSiath"></span></p>
                            <p><strong>Celular IRIS-PI:</strong> <span id="txtCelularIris"></span></p>
                        </div>

                        <!-- Columna 3: Información del cuadrante -->
                        <div class="col-md-4">
                            <h6 class="fw-bold">INFORMACIÓN DEL CUADRANTE:</h6>
                            <p><strong></strong> 
                            <p><span id="txtCodigoCuadrante"></span></p>
                            <p><span id="txtEstacion1"></span></p>
                            <p><span id="txtEstacion2"></span></p>
                            <p><span id="txtComando"></span></p>
                            <p><strong>Celular cuadrante:</strong> <span id="txtCelularCuadrante"></span></p>
                        </div>

                         <div class="col-md-12">
                          
                            <p><strong>Características Generales:</strong> <span id="txtCaracteristicas"></span></p>
                        </div>
                    </div>
                </div>


