<section class="content-header"></section>

<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span>Inicio</span></a></li>

            <li class="active">Instrumento de Recolección de Información del Servicio de Policía / Seguimiento IRIS P1</li>
        </ul>
    </div>
</div>

@*
   BUSQUEDA POR AÑOS----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
*@
<div class="card border-success">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white mb-0">
            <i class="fa fa-search"></i> Consulta IRIS
        </h4>
        <div class="card-actions ms-auto d-flex button-group">
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="link text-white d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="link text-white d-flex align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>

    <div class="card-body collapse show">
        <div class="row align-items-end g-3">
            <!-- Select -->
            <div class="col-md-2">
                <div class="form-group has-float-label">
                    @Html.DropDownList("ddlAnioIris", null, String.Format("Seleccione"),
                             htmlAttributes: new { @tabindex = 12, id = "ddlAnioIris", @class = "form-control select2", style = "width: 100%;" })
                    <label class="Labels">Ver IRIS-P1 por año</label>
                </div>
            </div>

            <!-- Botones en la misma fila -->
            <div class="col-md-auto d-flex gap-2">
                @* <button tabindex="1002" id="btnNuevo"
                        class="btn btn-limpiar"
                        style="border-radius: 0px 16px 0px 16px !important;"
                        title="Nuevo">
                    <span class="fa ico_limpiar faa-ring animated"></span> Nuevo IRIS
                </button> *@

                <button id="btnDescargarExcel" class="btn btn-excel rounded-pil">
                    <i class="fas fa-file-excel me-2"></i> Descargar Excel
                </button>
            </div>
        </div>
    </div>
</div>


@*
  FIN  BUSQUEDA POR AÑOS ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
*@

<input type="text" id="txtUndeLabora" class="d-none" value="@ViewBag.txtUndeLabora" />
<input type="text" id="txtCodDane" class="d-none" value="@ViewBag.txtCodDane" />
<input type="text" id="txtCodSiedcoEstacion" class="d-none" value="@ViewBag.txtCodSiedcoEstacion" />
<input type="text" id="txtCodSiedcoCuadrante" class="d-none" value="@ViewBag.txtCodSiedcoCuadrante" />
