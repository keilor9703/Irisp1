<div class="modal fade" id="Modal_InsResponable" aria-labelledby="bs-example-modal-lg" aria-hidden="true">
    <div class="modal-dialog" style="max-width: 800px;">

        <div class="modal-content">
            <div class="modal-header d-flex align-items-center">
                <h3 class="modal-title" id="myLargeModalLabel" style="font-weight: bold;">Asignar Responsable</h3>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <!-- Campo Tipo -->
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            @Html.DropDownList("ddlTipoUnidad", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlTipoUnidad", @class = "form-control select2", style = "width: 100%;" })
                            <label class="Labels">Unidad:</label>
                        </div>
                    </div>
                    <div class="col-md-6 MargFloatBoos">
                        <div class="form-group has-float-label">
                            @Html.DropDownList("ddlTipoDependencia", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlTipoDependencia", @class = "form-control select2", style = "width: 100%;" })
                            <label class="Labels">Dependencia:</label>
                        </div>
                    </div>

                </div>

                <div class="row">
                     
                    <div class="col-md-5 MargFloatBoos">
                        <div class="form-group has-float-label">
                            @Html.DropDownList("ddlTipoTarea", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 7, id = "ddlTipoTarea", @class = "form-control select2", style = "width: 100%;" })
                            <label class="Labels">Tarea:</label>
                        </div>
                    </div>
                </div>

                       
                <!-- Observaciones -->
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group has-float-label">
                            <textarea id="txtObservaciones" name="txtObservaciones" rows="3" class="form-control InputPading" placeholder="Digite una observación (campo opcional)"></textarea>
                            <label class="Labels">Observaciones:</label>
                        </div>
                    </div>
                </div>

              
            </div>

            <div class="modal-footer" style="justify-content:center;">
                <button type="button" id="btnGuardarResponsable"  style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-grad">
                    <span class="fa ico_grabar faa-wrench animated"></span>Guardar
                </button>
            </div>
        </div>
    </div>
</div>






