@* GRILLA ETAPA DE VERIFICACION *@
<div class="card border-success hidden" id="pn_GrillaVerificacion">
    <div class="card-header d-flex align-items-center">
    <h4 class="card-title text-white"><i class="fas fa-clipboard-list"></i> Etapa de Verificación</h4>
    <div class="card-actions ms-auto d-flex button-group">
        <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
        <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
        <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close"><i data-feather="x" class="feather-sm"></i></a>
    </div>
    </div>
    <div class="card-body collapse show">
    <div class="row">
        <div class="col-md-12">
        <!-- Evitamos table-responsive para no interferir con scrollX -->
        <div class="dt-container" style="width:100%; margin-top:0;">
            <table id="tbGrilla" class="table table-bordered table-striped" width="100%" style="margin-top:-1px;"></table>
        </div>
        </div>
    </div>
    </div>
</div>

@* GRILLA ETAPA DE INVESTIGACION *@
<div class="card border-success hidden" id="pn_GrillaInvestigacion">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="fa fa-eye"></i> Etapa de Investigación</h4>
    <div class="card-actions ms-auto d-flex button-group">
        <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
        <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
        <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close"><i data-feather="x" class="feather-sm"></i></a>
    </div>
    </div>
    <div class="card-body collapse show">
    <div class="row">
        <div class="col-md-12">
        <div class="dt-container" style="width:100%; margin-top:0;">
            <table id="tbGrillaInvestigacion" class="table table-bordered table-striped" width="100%" style="margin-top:-1px;"></table>
        </div>
        </div>
    </div>
    </div>
</div>

@* GRILLA ETAPA DE FINALIZACION *@
<div class="card border-success hidden" id="pn_GrillaFinalizacion">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="fa fa-check-square-o"></i> Etapa de Finalización</h4>
    <div class="card-actions ms-auto d-flex button-group">
        <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
        <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
        <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close"><i data-feather="x" class="feather-sm"></i></a>
    </div>
    </div>
    <div class="card-body collapse show">
    <div class="row">
        <div class="col-md-12"> <!-- corregido (antes col-md-40) -->
        <div class="dt-container" style="width:100%; margin-top:0;">
            <table id="tbGrillaFinalizacion" class="table table-bordered table-striped" width="100%" style="margin-top:-1px;"></table>
        </div>
        </div>
    </div>
    </div>
</div>



