    <script src="~/areas/irisp1/CrearUbicacion.js"></script> 

    <script type='text/javascript'>

        var UrlGetInfoGrillas = "@Url.Action("F_GetInfoGrillas", "Seguimiento", new { Area = "Irisp1" })";
        var UrlGetAniosIrisp1 = "@Url.Action("F_GetAniosIrisP1", "Seguimiento", new { Area = "Irisp1" })";
        var UrlConsultarAnioSeguimiento= "@Url.Action("ConsultarAnioSeguimiento", "Seguimiento", new { Area = "Irisp1" })";
        var UrlGetFuncionarios = "@Url.Action("F_GetFuncionarios", "Empleados", new { Area = "" })";
        var UrlGetIntegrantes= "@Url.Action("F_GetIntegrantes", "RegistrosIrisp1", new { Area = "Irisp1" })";
        var UrlGetUbicacion= "@Url.Action("F_GetUbicacionIris", "RegistrosIrisp1", new { Area = "Irisp1" })";     
        var UrlGetDelitosIris= "@Url.Action("F_GetDelitosIris", "RegistrosIrisp1", new { Area = "Irisp1" })";
        var UrlGetInfoAdicional= "@Url.Action("F_GetInfoAdicional", "RegistrosIrisp1", new { Area = "Irisp1" })";
        var UrlGetDocIris= "@Url.Action("F_GetDocIris", "RegistrosIrisp1", new { Area = "Irisp1" })";
        var UrlGetResponsable= "@Url.Action("F_GetResponsables", "Seguimiento", new { Area = "Irisp1" })";
        var UrlGetResponsablesTareasIris= "@Url.Action("F_GetResponsablesTareasIris", "Verificacion", new { Area = "Irisp1" })";
         var UrlGetResultadosIris = "@Url.Action("F_GetResultados", "Verificacion", new { Area = "Irisp1" })";

    </script>
}


<section class="content-header"></section>

<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span>Inicio</span></a></li>

            <li class="active">Intrumento de Recoleccion de Informacion del Servicio de Policia / Seguimiento IRIS P1</li>
        </ul>
    </div>
</div>

@*
   BUSQUEDA POR AÑOS----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
*@
<div class="card border-success">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class=" fas fa-clipboard-list  "></i> Consulta IRIS</h4>
        <div class="card-actions ms-auto d-flex button-group">
            <a class="link text-white d-flex align-items-center" data-action="collapse"><i class="ti-minus"></i></a>
            <a class="mb-0 btn-minimize text-white link d-flex align-items-center" data-action="expand"><i class="mdi mdi-arrow-expand"></i></a>
            <a class="mb-0 link d-flex text-white align-items-center pe-0" data-action="close">
                <i data-feather="x" class="feather-sm"></i>
            </a>
        </div>
    </div>
     <div class="card-body collapse show">
        <div class="row" > <!-- Se agrega margen superior aquí -->
            <div class="col-md-2 MargFloatBoos">
                <div class="form-group has-float-label">
                

                     @Html.DropDownList("ddlAnioIris", null, String.Format("Seleccione"), htmlAttributes: new { @tabindex = 12, id = "ddlAnioIris", @class = "form-control select2", style = "width: 100%;" })
                   
                    <label class="Labels">Ver IRIS-P1 por año</label>
                </div>
            </div>
            <div class="col-md-2 ">
                <button tabindex="1002" id="btnLimpiar" onclick="AbrirModalNuevoIris();" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-limpiar" title="Nuevo">
                    <span class="fa ico_limpiar faa-ring animated"></span> Nuevo IRIS
                </button>
            </div>
        </div>
     </div>
</div>

@*
  FIN  BUSQUEDA POR AÑOS ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
*@

<input type="text" id="txtUndeLabora" class="d-none" value="@ViewBag.txtUndeLabora" />
