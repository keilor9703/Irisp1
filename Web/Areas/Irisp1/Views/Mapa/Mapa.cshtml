
@section scripts {
    <!-- Carga la API de ArcGIS -->
    <link rel="stylesheet" href="https://js.arcgis.com/3.23/dijit/themes/claro/claro.css">
    <link rel="stylesheet" href="https://js.arcgis.com/3.44/esri/css/esri.css">
    <script src="https://js.arcgis.com/3.44/"></script>
    <script src="~/areas/irisp1/mapairisp1.js"></script>
    <script src="~/areas/irisp1/CrearUbicacion.js"></script>
}

<section class="content-header"></section>

<div class="page-titles">
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a id="no-link" href="@Url.Action("Index", "Home", new { Area = "" })"><i class="fa fa-home"></i> <span>Inicio</span></a></li>

            <li class="active">Instrumento de Recoleccion de Informacion del Servicio de Policía / Mapa</li>
        </ul>
    </div>
</div>

@*
   BUSQUEDA POR AÑOS----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
*@

<div class="card border-success">
    <div class="card-header d-flex align-items-center">
        <h4 class="card-title text-white"><i class="fa-map-marker"></i>  Mapa</h4>
    </div>
</div>
<fieldset>
    <legend class="custom-legend" @* style="width:0 *@ !important;"></legend>

    <div class="row">
        <div class="col-md-6 MargFloatBoos">
            <div class="form-group has-float-label">
                @Html.DropDownList("ddlAñoIris", new List<SelectListItem> { new SelectListItem { Text = "Seleccione el tipo de mapa", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlAñoIris", @class = "form-control select2", style = "width: 100%;" })
                <label class="Labels">Tipo de mapa</label>
            </div>
        </div>
        <div class="col-md-6 MargFloatBoos">
            <div class="form-group has-float-label">
                @Html.DropDownList("ddlAñoIris", new List<SelectListItem> { new SelectListItem { Text = "Seleccione el año", Value = "0" } }, htmlAttributes: new { @tabindex = 5, @id = "ddlAñoIris", @class = "form-control select2", style = "width: 100%;" })
                <label class="Labels">Ver IRIS del año</label>
            </div>
        </div>
        <div class="card-footer" style="margin-bottom: 10px;">
            <div class="col-md-12 text-right">
                <button tabindex="7603" type="button" id="btnConsultar" onclick="OpenModal(); return false;" style="border-radius: 0px 16px 0px 16px !important;" class="btn btn-buscar" title="Buscar"><span class="fa ico_buscar faa-pulse animated white"></span> Buscar</button>

            </div>
        </div>

</fieldset>
@*
  FIN  BUSQUEDA POR AÑOS ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
*@
