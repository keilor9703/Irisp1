@model Comun.Areas.Admin.MfaEnrollViewModel

@{
    ViewData["Title"] = "Activar verificación (TOTP)";
    Layout = "_LayoutAuth";
}

<div class="card auth-card" role="dialog" aria-modal="true" aria-labelledby="mfaTitle">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0" id="mfaTitle">Activar doble factor (TOTP)</h5>
        <a asp-controller="Cuenta" asp-action="InicioSesion" class="btn btn-sm btn-outline-light">✕</a>
    </div>

    <div class="card-body">
        <p class="text-muted mb-3">
            Escanee el QR con <b>Google Authenticator</b>, <b>Microsoft Authenticator</b> o <b>Authy</b>.
            Luego ingrese el código de 6 dígitos para confirmar.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <div class="row g-4">
            <div class="col-md-6">
                <div class="border rounded p-3 text-center bg-white">
                    <div class="mb-2 fw-bold">Código QR</div>

                    @if (!string.IsNullOrWhiteSpace(Model?.QrCodeBase64Png))
                    {
                        <img alt="QR TOTP"
                             style="max-width: 280px; width: 100%; height: auto;"
                             src="data:image/png;base64,@Model.QrCodeBase64Png" />
                    }
                    else
                    {
                        <div class="text-danger">No se pudo generar el QR. Recargue la página.</div>
                    }
                </div>

                <div class="mt-3">
                    <div class="fw-bold">Clave manual</div>
                    <code style="font-size:1.05rem; word-break: break-all;">@Model?.ManualKey</code>
                    <div class="text-muted" style="font-size:.9rem;">(No la comparta.)</div>
                </div>
            </div>

            <div class="col-md-6">
                <form asp-action="Enroll" method="post" class="border rounded p-3 bg-white">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">Código</label>
                        <input asp-for="Code"
                               class="form-control"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               maxlength="6"
                               placeholder="Ej: 123456" />
                        <span asp-validation-for="Code" class="text-danger"></span>

                        <div class="text-muted mt-1" style="font-size:.9rem;">
                            Si falla, revise la <b>hora automática</b> del celular.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Confirmar y activar</button>
                        <a asp-controller="Cuenta" asp-action="InicioSesion" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>

                <div class="alert alert-warning mt-3 mb-0">
                    <b>Nota:</b> si cambia de celular, deberá re-enrolar MFA.
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer text-muted" style="font-size:.9rem;">
        Seguridad IRIS-P1 • Verificación TOTP
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("input", function (e) {
            if (e.target && e.target.name === "Code") {
                e.target.value = (e.target.value || "").replace(/\D/g, "").slice(0, 6);
            }
        });

        // Focus inicial al input
        window.addEventListener("load", () => {
            const el = document.querySelector('input[name="Code"]');
            if (el) el.focus();
        });
    </script>
}
