@{
    ViewData["Title"] = "Acceso temporalmente bloqueado";
    Layout = "_Layout";

    var hasta = ViewBag.BloqueoHasta as DateTime?;
}

<div class="container mt-4" style="max-width: 650px;">
    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Acceso bloqueado temporalmente</h4>
        </div>

        <div class="card-body">
            <p>
                Se detectaron varios intentos fallidos de verificación. Por seguridad, el acceso a MFA está bloqueado temporalmente.
            </p>

            @if (hasta.HasValue)
            {
                <div class="alert alert-warning">
                    Podrá intentar nuevamente a partir de:
                    <b>@hasta.Value.ToString("yyyy-MM-dd HH:mm:ss")</b>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    Intente nuevamente más tarde.
                </div>
            }

            <div class="d-grid gap-2">
                <a asp-controller="Cuenta" asp-action="InicioSesion" class="btn btn-outline-secondary">
                    Volver al inicio de sesión
                </a>
            </div>
        </div>
    </div>
</div>
