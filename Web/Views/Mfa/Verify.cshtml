@model Comun.Areas.Admin.MfaVerifyViewModel

@{
    ViewData["Title"] = "Verificación de seguridad";
    Layout = "_LayoutAuth";
}

<div class="card auth-card" style="width: min(560px, 96vw);" role="dialog" aria-modal="true" aria-labelledby="verifyTitle">
    <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0" id="verifyTitle">Verificación de seguridad</h5>
        <a asp-controller="Cuenta" asp-action="InicioSesion" class="btn btn-sm btn-outline-light">✕</a>
    </div>

    <div class="card-body">
        <p class="text-muted mb-3">
            Ingrese el código de 6 dígitos generado por su app de autenticación.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Verify" method="post" class="border rounded p-3 bg-white">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Code" class="form-label">Código</label>
                <input asp-for="Code"
                       class="form-control"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="6"
                       placeholder="Ej: 123456" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberDevice" class="form-check-input" />
                <label asp-for="RememberDevice" class="form-check-label">
                    Confiar en este equipo
                </label>
                <div class="text-muted" style="font-size:.9rem;">
                    Úselo solo en equipos institucionales o confiables.
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-success">Verificar</button>
                <a asp-controller="Cuenta" asp-action="InicioSesion" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>

        <div class="text-muted mt-3" style="font-size:.9rem;">
            Si no tiene configurada la app, el sistema lo enviará al enrolamiento.
        </div>
    </div>

    <div class="card-footer text-muted" style="font-size:.9rem;">
        Seguridad IRIS-P1 • Validación TOTP
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("input", function (e) {
            if (e.target && e.target.name === "Code") {
                e.target.value = (e.target.value || "").replace(/\D/g, "").slice(0, 6);
            }
        });

        window.addEventListener("load", () => {
            const el = document.querySelector('input[name="Code"]');
            if (el) el.focus();
        });
    </script>
}
