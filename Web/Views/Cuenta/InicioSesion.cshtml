@model Comun.Areas.Admin.DtoCredenciales

@{
    Layout = null;

    // Flags/control desde CuentaController
    bool mfaShow = (ViewBag.MfaShow as bool?) ?? false;
    string mfaMode = (ViewBag.MfaMode as string ?? "").ToLower(); // "enroll" | "verify"
    string? mfaQrBase64 = ViewBag.MfaQrBase64 as string;
    string? mfaManualKey = ViewBag.MfaManualKey as string;

    string? mfaError = TempData["MfaError"] as string;

    string? mfaSvcMsg = ViewBag.MfaSvcMsg as string;
}

@if (TempData["MfaInfo"] != null)
{
    <div class="mfa-banner" role="status" aria-live="polite">
        <div class="mfa-banner__content">
            <span class="mfa-banner__icon" aria-hidden="true">✅</span>
            <span class="mfa-banner__text">@TempData["MfaInfo"]</span>
        </div>

        <button type="button" class="mfa-banner__close" aria-label="Cerrar"
                onclick="this.closest('.mfa-banner').remove();">
            ✕
        </button>
    </div>
}


<!DOCTYPE html>
<html dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex,nofollow">
    <title>Login IRIS-P1</title>

    <link rel="icon" type="image/png" sizes="16x16" href="~/img/Logos/LogoLoginLat.png">

    <link href="~/templatemonster_bt5/dist/css/style.min.css" rel="stylesheet" />
    <link href="~/css/colores.css" rel="stylesheet" />
    <link href="~/css/Login.css" rel="stylesheet" />
    <link href="~/css/Cargando.css" rel="stylesheet" />

    <style>

        .mfa-banner {
            position: fixed;
            top: 14px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 9999;
            width: min(980px, calc(100% - 28px));
            padding: 12px 14px;
            border-radius: 14px;
            border: 1px solid rgba(0, 255, 140, .25);
            background: linear-gradient(90deg, rgba(0, 90, 55, .92), rgba(0, 40, 28, .92));
            box-shadow: 0 10px 28px rgba(0,0,0,.35);
            color: #eafff4;
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: space-between;
            animation: mfaBannerIn .22s ease-out;
        }

        .mfa-banner__content {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 0;
        }

        .mfa-banner__icon {
            width: 28px;
            height: 28px;
            display: grid;
            place-items: center;
            border-radius: 10px;
            background: rgba(0, 255, 140, .12);
            border: 1px solid rgba(0, 255, 140, .22);
            flex: 0 0 auto;
        }

        .mfa-banner__text {
            font-size: 14px;
            line-height: 1.25;
            opacity: .95;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mfa-banner__close {
            border: 0;
            background: rgba(255,255,255,.06);
            color: #eafff4;
            width: 34px;
            height: 34px;
            border-radius: 12px;
            cursor: pointer;
            transition: .15s ease;
            flex: 0 0 auto;
        }

            .mfa-banner__close:hover {
                background: rgba(255,255,255,.12);
                transform: translateY(-1px);
            }

        @@keyframes mfaBannerIn {
            from {
                opacity: 0;
                transform: translateX(-50%) translateY(-8px);
            }

            to {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }
        }



        /* ===== MFA Modern UI ===== */
        .mfa-modal .modal-content {
            border: 0;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 16px 40px rgba(0,0,0,.20);
        }

        .mfa-modal .modal-header {
            border: 0;
            padding: 18px 20px;
            color: #fff;
            background: linear-gradient(135deg, #0d6efd 0%, #17a2b8 100%);
        }

        .mfa-modal .modal-title {
            font-weight: 700;
            letter-spacing: .2px;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
            color: white;
        }

            .mfa-modal .modal-title .mfa-icon {
                width: 38px;
                height: 38px;
                border-radius: 12px;
                background: rgba(255,255,255,.18);
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

        .mfa-modal .btn-close {
            filter: invert(1) grayscale(100%);
            opacity: .9;
        }

        .mfa-modal .modal-body {
            padding: 20px;
            background: #f7f9fc;
        }

        .mfa-card {
            background: #fff;
            border: 1px solid rgba(15,23,42,.08);
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 8px 18px rgba(15,23,42,.06);
        }

        .mfa-help {
            color: #475569;
            font-size: .95rem;
            line-height: 1.35rem;
        }

        .mfa-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 12px;
            border-radius: 999px;
            background: rgba(13,110,253,.10);
            color: #0b5ed7;
            font-weight: 600;
            font-size: .88rem;
        }

        .mfa-qr {
            max-width: 220px;
            width: 100%;
            height: auto;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.10);
            background: #fff;
            padding: 10px;
        }

        .mfa-manual {
            display: inline-block;
            width: 100%;
            padding: 10px 12px;
            border-radius: 12px;
            background: #0b1220;
            color: #e2e8f0;
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
            font-size: .95rem;
            overflow-wrap: anywhere;
        }

        .mfa-divider {
            height: 1px;
            background: rgba(15,23,42,.10);
            margin: 14px 0;
        }

        .mfa-actions .btn {
            border-radius: 12px;
            padding: 10px 12px;
            font-weight: 700;
        }

        .mfa-actions .btn-outline-secondary {
            border-color: rgba(15,23,42,.18);
        }

        /* OTP boxes */
        .otp-wrap {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin-top: 8px;
        }

        .otp-box {
            width: 46px;
            height: 54px;
            text-align: center;
            font-size: 1.35rem;
            font-weight: 800;
            border-radius: 14px;
            border: 1px solid rgba(15,23,42,.18);
            background: #fff;
            outline: none;
        }

            .otp-box:focus {
                border-color: rgba(13,110,253,.65);
                box-shadow: 0 0 0 .2rem rgba(13,110,253,.18);
            }

        @@media (max-width: 420px) {
            .otp-box {
                width: 40px;
                height: 50px;
            }

            .mfa-modal .modal-body {
                padding: 14px;
            }
        }
    </style>

</head>

<body>
    <div class="main-wrapper">

        <!-- Preloader -->
        <div class="preloader">
            <svg class="tea lds-ripple" width="37" height="48" viewbox="0 0 37 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M27.0819 17H3.02508C1.91076 17 1.01376 17.9059 1.0485 19.0197C1.15761 22.5177 1.49703 29.7374 2.5 34C4.07125 40.6778 7.18553 44.8868 8.44856 46.3845C8.79051 46.79 9.29799 47 9.82843 47H20.0218C20.639 47 21.2193 46.7159 21.5659 46.2052C22.6765 44.5687 25.2312 40.4282 27.5 34C28.9757 29.8188 29.084 22.4043 29.0441 18.9156C29.0319 17.8436 28.1539 17 27.0819 17Z" stroke="#009efb" stroke-width="2"></path>
                <path d="M29 23.5C29 23.5 34.5 20.5 35.5 25.4999C36.0986 28.4926 34.2033 31.5383 32 32.8713C29.4555 34.4108 28 34 28 34" stroke="#009efb" stroke-width="2"></path>
                <path id="teabag" fill="#009efb" fill-rule="evenodd" clip-rule="evenodd" d="M16 25V17H14V25H12C10.3431 25 9 26.3431 9 28V34C9 35.6569 10.3431 37 12 37H18C19.6569 37 21 35.6569 21 34V28C21 26.3431 19.6569 25 18 25H16ZM11 28C11 27.4477 11.4477 27 12 27H18C18.5523 27 19 27.4477 19 28V34C19 34.5523 18.5523 35 18 35H12C11.4477 35 11 34.5523 11 34V28Z"></path>
                <path id="steamL" d="M17 1C17 1 17 4.5 14 6.5C11 8.5 11 12 11 12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="#009efb"></path>
                <path id="steamR" d="M21 6C21 6 21 8.22727 19 9.5C17 10.7727 17 13 17 13" stroke="#009efb" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
        </div>

        <!-- Login -->
        <div class="LoginA auth-wrapper d-flex no-block justify-content-center align-items-center">
            <div class="LoginB auth-box on-sidebar bg-white m-0">
                <div id="loginBox" style="margin-top:33px;">
                    <div class="logo text-center" style="margin-bottom:-33px">
                        <span class="text-center h3" style="color: white">Policía Nacional</span>
                        <br />
                        <span class="db">
                            <img src="~/img/LogoIrisp1.png" alt="logo" width="369px"
                                 style="margin-top: -8px;margin-bottom: 26px;" class="img-responsive" />
                        </span>
                        <br />
                    </div>

                    <div class="row" style="padding: 0px 66px 0px 89px;">
                        <div class="col-12">
                            <form class="form-horizontal mt-3 form-material"
                                  id="loginform"
                                  asp-controller="Cuenta"
                                  asp-action="InicioSesion"
                                  method="post"
                                  asp-route-returnurl="@ViewData["ReturnUrl"]">

                                @Html.AntiForgeryToken()

                                <div class="form-group mb-3">
                                    <div class="col-xs-12">
                                        <input asp-for="UsuarioEmpresarial"
                                               class="form-control"
                                               required
                                               placeholder="Usuario Empresarial"
                                               autocomplete="off"
                                               style="border:none; width:100%; border-block-color:#ffffff; color: white;" />
                                        <span asp-validation-for="UsuarioEmpresarial" class="text-yellow"></span>
                                    </div>
                                </div>

                                <div class="form-group mb-3">
                                    <div class="col-xs-12">
                                        <input asp-for="ClaveEmpresarial"
                                               class="form-control"
                                               required
                                               placeholder="Contraseña"
                                               autocomplete="new-password"
                                               style="border:none; width:100%; color: white;" />
                                        <span asp-validation-for="ClaveEmpresarial" class="text-yellow"></span>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <div class="d-flex">
                                        <div>
                                            <a href="https://gestionacceso.policia.gov.co:8443/" target="_blank"
                                               class="link font-weight-medium">
                                                <i class="fa fa-lock me-1" style="margin-left:40px;margin-top:-9px"></i>
                                                Cambiar contraseña
                                            </a>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group text-center my-3">
                                    <div class="col-xs-12" style="margin-top:11px; width:100%;">
                                        <button class="btn btn-outline-info w-100 waves-effect waves-light"
                                                type="submit" id="btnIngresar" name="btnIngresar">
                                            Ingresar
                                        </button>
                                    </div>
                                </div>

                                <div style="margin-bottom: -115px;" class="text-yellow" asp-validation-summary="All"></div>

                                <div class="form-group text-center my-3">
                                    <div class="col-sm-12 TextoSeguridad">
                                        <span>
                                            Está ingresando a un sistema de información de propiedad de la <b>Policía Nacional</b>,
                                            su uso no autorizado incurre en el incumplimiento de las políticas de seguridad de la Institución establecidas en
                                            el Manual del Sistema de Gestión de Seguridad de la Información para la Policía Nacional y acarrea sanciones penales,
                                            disciplinarias y/o administrativas a que haya lugar; ayúdenos a prevenir la divulgación no autorizada,
                                            pérdida y/o fuga de la información institucional.
                                        </span>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Loader -->
    <div id="Process">
        <div class="loader_sis">
            <div class="loader_dialoge">
                <div class="loader_containere text-center">
                    <div class="loadere"></div>
                    <h4 class="text-white">Procesando, espere...</h4>
                </div>
            </div>
        </div>
        <div class="loader_backe"></div>
    </div>

    <!-- ===========================
         MODAL: MFA ENROLL (AJUSTADA)
         =========================== -->
    <div class="modal fade mfa-modal" id="mfaEnrollModal" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="mfa-icon">🔐</span>
                        Activar doble factor (TOTP)
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
                </div>

                <div class="modal-body">
                    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
                        <span class="mfa-badge">✅ Recomendado para mayor seguridad</span>
                        <small class="mfa-help">Apps: Google Authenticator, Microsoft Authenticator, Authy</small>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mfaError))
                    {
                        <div class="alert alert-danger mb-3">@mfaError</div>
                    }

                    <div class="row g-3">
                        <!-- QR / clave manual -->
                        <div class="col-md-6">
                            <div class="mfa-card h-100">
                                <div class="fw-bold mb-2">1) Escanee el QR</div>
                                <div class="mfa-help mb-3">
                                    Abra su app de autenticación y agregue una cuenta con el código QR.
                                </div>

                                <div class="text-center">
                                    @if (!string.IsNullOrWhiteSpace(mfaQrBase64))
                                    {
                                        <img class="mfa-qr" alt="QR TOTP" src="data:image/png;base64,@mfaQrBase64" />
                                    }
                                    else
                                    {
                                        <div class="text-danger fw-bold">No se pudo generar el QR. Intente nuevamente.</div>
                                    }
                                </div>

                                <div class="mfa-divider"></div>

                                <div class="fw-bold mb-1">Clave manual</div>
                                <div class="mfa-help mb-2">Úsela si no puede escanear. (Base32. No la comparta.)</div>
                                <code class="mfa-manual">@mfaManualKey</code>
                            </div>
                        </div>

                        <!-- Confirmación -->
                        <div class="col-md-6">
                            <div class="mfa-card h-100">
                                <div class="fw-bold mb-2">2) Confirme con el código de 6 dígitos</div>
                                <div class="mfa-help">
                                    Si falla, revise que el celular tenga <b>hora automática</b> activada.
                                </div>

                                <form asp-controller="Cuenta" asp-action="MfaEnrollConfirm" method="post" class="mt-3" id="otpEnroll">
                                    @Html.AntiForgeryToken()

                                    <!-- Hidden real -->
                                    <input type="hidden" name="Code" />

                                    <!-- OTP UI -->
                                    <div class="otp-wrap" data-otp="true">
                                        <input class="otp-box" inputmode="numeric" autocomplete="one-time-code" />
                                        <input class="otp-box" inputmode="numeric" />
                                        <input class="otp-box" inputmode="numeric" />
                                        <input class="otp-box" inputmode="numeric" />
                                        <input class="otp-box" inputmode="numeric" />
                                        <input class="otp-box" inputmode="numeric" />
                                    </div>

                                    <div class="mfa-actions d-grid gap-2 mt-4">
                                        <button type="submit" class="btn btn-primary">
                                            Confirmar y activar
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary" onclick="mfaCancel()">
                                            Cancelar
                                        </button>
                                    </div>

                                    <div class="alert alert-warning mt-3 mb-0">
                                        <b>Nota:</b> Si cambia de celular, deberá re-enrolar MFA (según política).
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- ===========================
         MODAL: MFA VERIFY (AJUSTADA)
         =========================== -->
    <div class="modal fade mfa-modal" id="mfaVerifyModal" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="mfa-icon">🛡️</span>
                        Verificación de seguridad
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
                </div>

                <div class="modal-body">
                    <div class="mfa-card">
                        <div class="fw-bold mb-1">Ingrese el código de 6 dígitos</div>
                        <div class="mfa-help mb-3">
                            Use el código generado por su app de autenticación.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mfaError))
                        {
                            <div class="alert alert-danger mb-3">@mfaError</div>
                        }

                        @if (!string.IsNullOrWhiteSpace(ViewBag.VerifyError as string))
                        {
                            <div class="alert alert-danger mb-3">@ViewBag.VerifyError</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ViewBag.VerifyInfo as string))
                        {
                            <div class="alert alert-info mb-3">@ViewBag.VerifyInfo</div>
                        }

                        <form asp-controller="Cuenta" asp-action="MfaVerifyConfirm" method="post" id="frmMfaVerify">
                            @Html.AntiForgeryToken()

                            <!-- OTP UI + Hidden real -->
                            <div id="otpVerify">
                                <input type="hidden" name="Code" />
                                <div class="otp-wrap" data-otp="true">
                                    <input class="otp-box" inputmode="numeric" autocomplete="one-time-code" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                </div>
                            </div>

                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="RememberDevice" value="true"  />
                                <label class="form-check-label" >Recordar este equipo</label>
                            </div>

                            <div class="mfa-actions d-grid gap-2 mt-4">
                                <button type="submit" class="btn btn-success">
                                    Verificar
                                </button>
                            </div>
                        </form>

                        <div class="mfa-divider"></div>

                        <form asp-controller="Cuenta" asp-action="MfaLostDevice" method="post" class="text-center">
                            @Html.AntiForgeryToken()
                            <button type="button" class="btn btn-link text-danger fw-bold p-0"
                                    data-bs-toggle="modal" data-bs-target="#mfaResetModal">
                                ¿Perdió su autenticador?
                            </button>

                        </form>

                        <div class="mfa-divider"></div>

                        <div class="mfa-help">
                            Si no tiene configurada la app, el sistema lo enviará a enrolamiento cuando aplique.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===========================
      MODAL: MFA RESET REGISTRO)
      =========================== -->

    <div class="modal fade mfa-modal" id="mfaResetModal" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <span class="mfa-icon">📧</span>
                        Restablecer MFA por correo institucional
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="mfa-card">
                        <div class="fw-bold mb-1">1) Enviaremos un código al correo institucional</div>
                        <div class="mfa-help mb-3">
                            El código dura <b>5 minutos</b>. Por seguridad, luego de validarlo habrá una espera corta antes de reenrolar.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ViewBag.ResetError as string))
                        {
                            <div class="alert alert-danger mb-3">@ViewBag.ResetError</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(ViewBag.ResetInfo as string))
                        {
                            <div class="alert alert-info mb-3">@ViewBag.ResetInfo</div>
                        }

                        <form asp-controller="Cuenta" asp-action="MfaResetRequest" method="post" class="d-grid gap-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-primary">
                                Enviar código al correo
                            </button>
                        </form>

                        <div class="mfa-divider"></div>

                        <div class="fw-bold mb-1">2) Ingrese el código de 6 dígitos recibido</div>

                        <form asp-controller="Cuenta" asp-action="MfaResetConfirm" method="post" id="frmMfaResetConfirm" class="mt-2">
                            @Html.AntiForgeryToken()

                            <div id="otpReset">
                                <input type="hidden" name="Code" />
                                <div class="otp-wrap" data-otp="true">
                                    <input class="otp-box" inputmode="numeric" autocomplete="one-time-code" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                </div>
                            </div>

                            <div class="mfa-actions d-grid gap-2 mt-3">
                                <button type="submit" class="btn btn-primary">
                                    Confirmar código
                                </button>
                            </div>
                        </form>

                        <div class="mfa-divider"></div>

                        <form asp-controller="Cuenta" asp-action="MfaResetExecute" method="post" class="d-grid gap-2" >
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success" hidden>
                                Continuar (si ya está disponible)
                            </button>
                        </form>

                        <div class="mfa-help mt-3">
                            Si aún no está disponible, el sistema le indicará la hora exacta en la que podrá reenrolar.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ===========================
     MODAL: MFA BLOCKED
     =========================== -->
    <div class="modal fade mfa-modal" id="mfaBlockedModal" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);">
                    <h5 class="modal-title">
                        <span class="mfa-icon">⛔</span>
                        Acceso temporalmente bloqueado
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
                </div>

                <div class="modal-body">
                    <div class="mfa-card">
                        <div class="fw-bold mb-2">Su cuenta tiene un bloqueo activo por seguridad.</div>

                        <div class="mfa-help mb-3">
                            Se detectaron intentos fallidos o una condición de seguridad que activó el bloqueo temporal del MFA.
                            Intente nuevamente cuando el bloqueo finalice.
                        </div>

                        <div class="alert alert-warning mb-3">
                            <div class="fw-bold">Bloqueo hasta:</div>
                            <div>
                                @{
                                    DateTime? bh = null;
                                    if (ViewBag.BloqueoHasta != null)
                                    {
                                        try { bh = (DateTime)ViewBag.BloqueoHasta; } catch { bh = null; }
                                    }
                                }

                                @if (bh.HasValue)
                                {
                                    <span id="bloqueoHastaText">@bh.Value.ToString("yyyy-MM-dd HH:mm:ss")</span>
                                }
                                else
                                {
                                    <span id="bloqueoHastaText">No disponible</span>
                                }
                            </div>

                            @if (bh.HasValue)
                            {
                                <div class="mt-2">
                                    <small class="fw-bold">
                                       Se habilitará automáticamente cuando expire el tiempo.
                                    </small>
                                </div>
                            }
                        </div>

                        <div class="mfa-divider"></div>

                        <div class="mfa-actions d-grid gap-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="mfaCancel()">
                                Volver al inicio de sesión
                            </button>
                            
                        </div>

                        <div class="mfa-help mt-3">
                            Si considera que esto es un error, contacte al Administrador o reporte el incidente según el canal institucional.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <!-- ===========================
     MODAL: MFA SERVICE DOWN
     =========================== -->
    <div class="modal fade mfa-modal" id="mfaServiceDownModal" tabindex="-1" aria-hidden="true"
         data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" style="max-width:580px;">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #dc3545 0%, #6f42c1 100%);">
                    <h5 class="modal-title">
                        <span class="mfa-icon">⚠️</span>
                        Servicio de doble autenticación no disponible
                    </h5>
                    <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
                </div>

                <div class="modal-body">
                    <div class="mfa-card">
                        <div class="fw-bold mb-2">No es posible iniciar sesión en este momento.</div>

                        <div class="mfa-help mb-3">
                            El servicio de <b>Doble Autenticación (2FA/MFA)</b> está presentando fallas o no se pudo establecer conexión.
                            Por política de seguridad, el acceso queda temporalmente restringido hasta que el servicio se restablezca.
                        </div>

                        @if (!string.IsNullOrWhiteSpace(mfaSvcMsg))
                        {
                            <div class="alert alert-danger mb-3">
                                <b>Detalle:</b> @mfaSvcMsg
                            </div>
                        }

                        <div class="alert alert-warning mb-0">
                            <b>Acción requerida:</b> por favor tomar contacto con el <b>Administrador Funcional</b> del sistema o con el
                            <b>técnico GUTIC</b> de su unidad.
                        </div>

                        <div class="mfa-divider"></div>

                        <div class="mfa-actions d-grid gap-2">
                            <button type="button" class="btn btn-outline-secondary" onclick="mfaCancel()">
                                Volver al inicio de sesión
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>




    <!-- JS -->
    <script src="~/lib/jquery/dist/jquery2024.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>





    <script>
        $(".preloader").fadeOut();
        $("#Process").hide();

        // OJO: usa submit del FORM, no click del botón
        $(document).on("submit", "form#loginform", function (e) {

            // Valida HTML5 (required, etc.)
            if (!this.checkValidity()) {
                // evita submit
                e.preventDefault();
                e.stopPropagation();

                // muestra los mensajes nativos del navegador
                this.reportValidity();

                // asegúrate de NO mostrar loader
                $("#Process").hide();
                return false;
            }

            // Si es válido, ahora sí muestra loader
            $("#Process").show();
            // (opcional) deshabilita el botón para evitar doble click
            $("#btnIngresar").prop("disabled", true);
        });
    </script>



    <script>
     

        // Cancelar MFA: va a una acción que limpie la sesión MFA_PENDING
        function mfaCancel() {
            window.location.href = '@Url.Action("MfaCancel", "Cuenta")';
        }

        
        // Abrir modal según el servidor
        (function () {
            var show = '@(mfaShow ? "1" : "0")';
            var mode = '@mfaMode'.toLowerCase(); // normalizamos a minúsculas

            if (show !== "1") return;

            var modalId = null;

            if (mode === "enroll") {
                modalId = 'mfaEnrollModal';
            } else if (mode === "verify") {
                modalId = 'mfaVerifyModal';
            } else if (mode === "reset") {
                modalId = 'mfaResetModal';
            } else if (mode === "blocked") {
                modalId = 'mfaBlockedModal';
            } else if (mode === "svcdown") {
                modalId = 'mfaServiceDownModal';
            }


            if (modalId) {
                var el = document.getElementById(modalId);
                if (el) new bootstrap.Modal(el).show();
            }
        })();



          
        window.addEventListener("load", () => {
          const b = document.querySelector(".mfa-banner");
          if (!b) return;
          setTimeout(() => b.remove(), 6000);
        });




    </script>

    <script>
        // Inicializa OTP (6 casillas) y sincroniza con input hidden name="Code"
        function initOtp(containerSelector) {
            const container = document.querySelector(containerSelector);
            if (!container) return;

            const inputs = container.querySelectorAll(".otp-box");
            const hidden = container.querySelector('input[type="hidden"][name="Code"]');
            if (!inputs.length || !hidden) return;

            const syncHidden = () => {
                hidden.value = Array.from(inputs).map(i => i.value || "").join("");
            };

            inputs.forEach((input, idx) => {
                input.addEventListener("input", () => {
                    input.value = (input.value || "").replace(/\D/g, "").slice(0, 1);
                    if (input.value && idx < inputs.length - 1) inputs[idx + 1].focus();
                    syncHidden();
                });

                input.addEventListener("keydown", (e) => {
                    if (e.key === "Backspace" && !input.value && idx > 0) {
                        inputs[idx - 1].focus();
                    }
                });

                input.addEventListener("paste", (e) => {
                    const text = (e.clipboardData || window.clipboardData).getData("text");
                    const digits = (text || "").replace(/\D/g, "").slice(0, inputs.length);
                    if (!digits) return;

                    e.preventDefault();
                    digits.split("").forEach((d, i) => { if (inputs[i]) inputs[i].value = d; });

                    const next = inputs[Math.min(digits.length, inputs.length - 1)];
                    if (next) next.focus();

                    syncHidden();
                });
            });

            inputs[0].focus();
        }

        // Al mostrar cada modal, inicializa sus OTP
        document.addEventListener("shown.bs.modal", function (e) {
          if (e.target && e.target.id === "mfaVerifyModal") initOtp("#otpVerify");
          if (e.target && e.target.id === "mfaEnrollModal") initOtp("#otpEnroll");
          if (e.target && e.target.id === "mfaResetModal") initOtp("#otpReset");
        });

    </script>

</body>
</html>
