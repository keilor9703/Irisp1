@{
    // Variables de control MFA leídas desde el ViewBag/TempData del sistema cliente
    bool mfaShow = (ViewBag.MfaShow as bool?) ?? false;
    string mfaMode = (ViewBag.MfaMode as string ?? "").ToLower();
    string? mfaQrBase64 = ViewBag.MfaQrBase64 as string;
    string? mfaManualKey = ViewBag.MfaManualKey as string;
    string? mfaError = TempData["MfaError"] as string;
    string? mfaSvcMsg = ViewBag.MfaSvcMsg as string;
}
<style>
    .mfa-banner { position: fixed; top: 14px; left: 50%; transform: translateX(-50%); z-index: 9999; width: min(980px, calc(100% - 28px)); padding: 12px 14px; border-radius: 14px; border: 1px solid rgba(0, 255, 140, .25); background: linear-gradient(90deg, rgba(0, 90, 55, .92), rgba(0, 40, 28, .92)); box-shadow: 0 10px 28px rgba(0,0,0,.35); color: #eafff4; backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: space-between; animation: mfaBannerIn .22s ease-out; }
    .mfa-banner__content { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .mfa-banner__icon { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 10px; background: rgba(0, 255, 140, .12); border: 1px solid rgba(0, 255, 140, .22); flex: 0 0 auto; }
    .mfa-banner__text { font-size: 14px; line-height: 1.25; opacity: .95; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mfa-banner__close { border: 0; background: rgba(255,255,255,.06); color: #eafff4; width: 34px; height: 34px; border-radius: 12px; cursor: pointer; transition: .15s ease; flex: 0 0 auto; }
    .mfa-banner__close:hover { background: rgba(255,255,255,.12); transform: translateY(-1px); }
    @@keyframes mfaBannerIn { from { opacity: 0; transform: translateX(-50%) translateY(-8px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }
    .mfa-modal .modal-content { border: 0; border-radius: 18px; overflow: hidden; box-shadow: 0 16px 40px rgba(0,0,0,.20); }
    .mfa-modal .modal-header { border: 0; padding: 18px 20px; color: #eafff4; background: linear-gradient(135deg, #0b3d2e 0%, #0f5c45 100%); box-shadow: inset 0 -1px 0 rgba(0,255,140,.15); }
    .mfa-modal .modal-title { font-weight: 700; letter-spacing: .2px; display: flex; align-items: center; gap: 10px; margin: 0; color: white; }
    .mfa-modal .modal-title .mfa-icon { width: 38px; height: 38px; border-radius: 12px; background: rgba(255,255,255,.18); display: inline-flex; align-items: center; justify-content: center; }
    .mfa-modal .btn-close { filter: invert(1) grayscale(100%); opacity: .9; }
    .mfa-modal .modal-body { padding: 20px; background: linear-gradient(180deg, #f4f6f5 0%, #e8f5e9 100%); }
    .mfa-card { background: #ffffff; border: 1px solid rgba(0, 90, 55, .15); border-radius: 16px; padding: 16px; box-shadow: 0 8px 18px rgba(0, 60, 40, .08); }
    .mfa-help { color: #475569; font-size: .95rem; line-height: 1.35rem; }
    .mfa-badge { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(13,110,253,.10); color: #0b5ed7; font-weight: 600; font-size: .88rem; }
    .mfa-qr { max-width: 220px; width: 100%; height: auto; border-radius: 14px; border: 1px solid rgba(0, 90, 55, .2); background: #fff; padding: 10px; }
    .mfa-manual { display: inline-block; width: 100%; padding: 10px 12px; border-radius: 12px; background: #0b1220; color: #e2e8f0; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: .95rem; overflow-wrap: anywhere; }
    .mfa-divider { height: 1px; background: rgba(15,23,42,.10); margin: 14px 0; }
    .mfa-actions .btn-primary, .mfa-actions .btn-success { background: linear-gradient(135deg, #0f5c45 0%, #00c853 100%); border: none; color: #fff; }
    .mfa-actions .btn-primary:hover, .mfa-actions .btn-success:hover { background: linear-gradient(135deg, #00c853 0%, #00e676 100%); transform: translateY(-1px); }
    .mfa-actions .btn-outline-secondary { border-color: rgba(0, 90, 55, .3); color: #0b3d2e; }
    .mfa-actions .btn-outline-secondary:hover { background: rgba(0, 90, 55, .08); }
    .alert-warning { background: rgba(255, 193, 7, .15); border: 1px solid rgba(255, 193, 7, .4); color: #5c4300; }
    .mfa-modal .alert-info { background: rgba(0, 200, 83, .12); border: 1px solid rgba(0, 200, 83, .35); color: #0b3d2e; }
    .mfa-modal .btn-outline-primary { border-color: #0f5c45; color: #0f5c45; }
    .mfa-modal .btn-outline-primary:hover { background: linear-gradient(135deg, #0f5c45 0%, #00c853 100%); color: #fff; border-color: #00c853; }
    .otp-wrap { display: flex; gap: 10px; justify-content: center; margin-top: 8px; }
    .otp-box { width: 46px; height: 54px; text-align: center; font-size: 1.35rem; font-weight: 800; border-radius: 14px; border: 1px solid rgba(0, 90, 55, .25); background: #ffffff; color: #0b3d2e; }
    .otp-box:focus { border-color: #00c853; box-shadow: 0 0 0 .2rem rgba(0, 200, 83, .25); }
    @@media (max-width: 420px) { .otp-box { width: 40px; height: 50px; } .mfa-modal .modal-body { padding: 14px; } }
</style>
@if (TempData["MfaInfo"] != null)
{
    <div class="mfa-banner" role="status" aria-live="polite">
        <div class="mfa-banner__content">
            <span class="mfa-banner__icon" aria-hidden="true">✅</span>
            <span class="mfa-banner__text">@TempData["MfaInfo"]</span>
        </div>
        <button type="button" class="mfa-banner__close" aria-label="Cerrar" onclick="this.closest('.mfa-banner').remove();">✕</button>
    </div>
}
<div class="modal fade mfa-modal" id="mfaEnrollModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="mfa-icon">🔐</span>Activar doble factor de autenticación (TOTP)</h5>
                <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
                    <span class="mfa-badge">✅ Recomendado para mayor seguridad</span>
                    <small class="mfa-help">Apps: Google Authenticator, Microsoft Authenticator, Authy</small>
                </div>
                @if (!string.IsNullOrWhiteSpace(mfaError)) { <div class="alert alert-danger mb-3">@mfaError</div> }
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="mfa-card h-100">
                            <div class="fw-bold mb-2">1) Escanee el QR</div>
                            <div class="mfa-help mb-3">Abra su app de autenticación y agregue una cuenta con el código QR.</div>
                            <div class="text-center">
                                <img id="mfaQrImage" class="mfa-qr" alt="QR TOTP"
                                     src="@(string.IsNullOrWhiteSpace(mfaQrBase64) ? "" : $"data:image/png;base64,{mfaQrBase64}")"
                                     style="@(string.IsNullOrWhiteSpace(mfaQrBase64) ? "display:none;" : "")" />

                                <div id="mfaQrError" class="text-danger fw-bold"
                                     style="@(string.IsNullOrWhiteSpace(mfaQrBase64) ? "" : "display:none;")">
                                    No se pudo generar el QR. Intente nuevamente.
                                </div>
                            </div>
                            <div class="mfa-divider"></div>
                            <div class="fw-bold mb-1">Clave manual</div>
                            <div class="mfa-help mb-2">Úsela si no puede escanear. (Base32. No la comparta.)</div>
                            <code id="mfaManualCode" class="mfa-manual">@mfaManualKey</code>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mfa-card h-100">
                            <div class="fw-bold mb-2">2) Confirme con el código de 6 dígitos</div>
                            <div class="mfa-help">Si falla, revise que el celular tenga <b>hora automática</b> activada.</div>
                            <form id="otpEnroll" method="post" class="mt-3">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="Code" />
                                <div class="otp-wrap" data-otp="true">
                                    <input class="otp-box" inputmode="numeric" autocomplete="one-time-code" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                    <input class="otp-box" inputmode="numeric" />
                                </div>
                                <div class="mfa-actions d-grid gap-2 mt-4">
                                    <button type="submit" class="btn btn-primary">Confirmar y activar</button>
                                    <button type="button" class="btn btn-outline-secondary" onclick="mfaCancel()">Cancelar</button>
                                </div>
                                <div class="alert alert-warning mt-3 mb-0"><b>Nota:</b> Si cambia de celular, deberá re-enrolar MFA.</div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade mfa-modal" id="mfaVerifyModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="mfa-icon">🛡️</span>Verificación de seguridad</h5>
                <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
            </div>
            <div class="modal-body">
                <div class="mfa-card">
                    <div class="fw-bold mb-1">Ingrese el código de 6 dígitos</div>
                    <div class="mfa-help mb-3">Use el código generado por su app de autenticación.</div>
                    @if (!string.IsNullOrWhiteSpace(mfaError)) { <div class="alert alert-danger mb-3">@mfaError</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.VerifyError as string)) { <div class="alert alert-danger mb-3">@ViewBag.VerifyError</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.VerifyInfo as string)) { <div class="alert alert-info mb-3">@ViewBag.VerifyInfo</div> }
                    <form id="frmMfaVerify" method="post">
                        @Html.AntiForgeryToken()
                        <div id="otpVerify">
                            <input type="hidden" name="Code" />
                            <div class="otp-wrap" data-otp="true">
                                <input class="otp-box" inputmode="numeric" autocomplete="one-time-code" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                            </div>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" name="RememberDevice" value="true" />
                            <label class="form-check-label">Recordar este equipo</label>
                        </div>
                        <div class="mfa-actions d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-success">Verificar</button>
                        </div>
                    </form>
                    <div class="mfa-divider"></div>
                    <div class="text-center">
                        <button type="button" class="btn btn-link text-danger fw-bold p-0" data-bs-toggle="modal" data-bs-target="#mfaResetModal" data-bs-dismiss="modal">
                            ¿Perdió su autenticador?
                        </button>
                    </div>
                    <div class="mfa-divider"></div>
                    <div class="mfa-help">Si no tiene configurada la app, el sistema lo enviará a enrolamiento cuando aplique.</div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade mfa-modal" id="mfaResetModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><span class="mfa-icon">📧</span>Restablecer MFA por correo institucional</h5>
                <button type="button" class="btn-close" aria-label="Close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mfa-card">
                    <div class="fw-bold mb-1">1) Enviaremos un código al correo institucional</div>
                    <div class="mfa-help mb-3">El código dura <b>5 minutos</b>. Por seguridad, luego de validarlo habrá una espera corta antes de reenrolar.</div>
                    @if (!string.IsNullOrWhiteSpace(ViewBag.ResetError as string)) { <div class="alert alert-danger mb-3">@ViewBag.ResetError</div> }
                    @if (!string.IsNullOrWhiteSpace(ViewBag.ResetInfo as string)) { <div class="alert alert-info mb-3">@ViewBag.ResetInfo</div> }
                    <form id="frmMfaResetReq" method="post" class="d-grid gap-2">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-primary">Enviar código al correo</button>
                    </form>
                    <div class="mfa-divider"></div>
                    <div class="fw-bold mb-1">2) Ingrese el código de 6 dígitos recibido</div>
                    <form id="frmMfaResetConfirm" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <div id="otpReset">
                            <input type="hidden" name="Code" />
                            <div class="otp-wrap" data-otp="true">
                                <input class="otp-box" inputmode="numeric" autocomplete="one-time-code" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                                <input class="otp-box" inputmode="numeric" />
                            </div>
                        </div>
                        <div class="mfa-actions d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">Confirmar código</button>
                        </div>
                    </form>
                    <div class="mfa-help mt-3 text-center">Si aún no está disponible, el sistema le indicará la hora exacta en la que podrá reenrolar.</div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade mfa-modal" id="mfaBlockedModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);">
                <h5 class="modal-title"><span class="mfa-icon">⛔</span>Acceso temporalmente bloqueado</h5>
                <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
            </div>
            <div class="modal-body">
                <div class="mfa-card">
                    <div class="fw-bold mb-2">Su cuenta tiene un bloqueo activo por seguridad.</div>
                    <div class="mfa-help mb-3">Se detectaron intentos fallidos o una condición de seguridad que activó el bloqueo temporal del MFA. Intente nuevamente cuando el bloqueo finalice.</div>
                    <div class="alert alert-warning mb-3">
                        <div class="fw-bold">Bloqueo hasta:</div>
                        <div>
                            @{
                                DateTime? bh = null;
                                if (ViewBag.BloqueoHasta != null) { try { bh = (DateTime)ViewBag.BloqueoHasta; } catch { bh = null; } }
                            }
                            @if (bh.HasValue) { <span id="bloqueoHastaText">@bh.Value.ToString("yyyy-MM-dd HH:mm:ss")</span> }
                            else { <span id="bloqueoHastaText">No disponible</span> }
                        </div>
                        @if (bh.HasValue) { <div class="mt-2"><small class="fw-bold">Se habilitará automáticamente cuando expire el tiempo.</small></div> }
                    </div>
                    <div class="mfa-divider"></div>
                    <div class="mfa-actions d-grid gap-2">
                        <button type="button" class="btn btn-outline-secondary" onclick="mfaCancel()">Volver al inicio de sesión</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade mfa-modal" id="mfaServiceDownModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" style="max-width:580px;">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #dc3545 0%, #6f42c1 100%);">
                <h5 class="modal-title"><span class="mfa-icon">⚠️</span>Servicio de doble autenticación no disponible</h5>
                <button type="button" class="btn-close" aria-label="Close" onclick="mfaCancel()"></button>
            </div>
            <div class="modal-body">
                <div class="mfa-card">
                    <div class="fw-bold mb-2">No es posible iniciar sesión en este momento.</div>
                    <div class="mfa-help mb-3">El servicio de <b>Doble Autenticación (2FA/MFA)</b> está presentando fallas o no se pudo establecer conexión. Por política de seguridad, el acceso queda temporalmente restringido hasta que el servicio se restablezca.</div>
                    @if (!string.IsNullOrWhiteSpace(mfaSvcMsg)) { <div class="alert alert-danger mb-3"><b>Detalle:</b> @mfaSvcMsg</div> }
                    <div class="alert alert-warning mb-0"><b>Acción requerida:</b> por favor tomar contacto con el <b>Administrador Funcional</b> del sistema o con el <b>técnico GUTIC</b> de su unidad.</div>
                    <div class="mfa-divider"></div>
                    <div class="mfa-actions d-grid gap-2">
                        <button type="button" class="btn btn-outline-secondary" onclick="mfaCancel()">Volver al inicio de sesión</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    async function mfaCancel() {
        try {
            await fetch('/MfaOrquestador/CancelAjax', { method: 'POST', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
        } catch (e) { console.error(e); }
        window.location.href = '/Cuenta/InicioSesion';
    }

    // Pinta los datos del enroll (QR + clave manual) y limpia los OTP boxes.
    // Es la pieza clave para que la transición Reset -> Enroll muestre SIEMPRE el QR.
    function paintEnrollModal(qrBase64, manualKey) {
        const enrollModalEl = document.getElementById('mfaEnrollModal');
        if (!enrollModalEl) return;

        const qrImg     = enrollModalEl.querySelector('#mfaQrImage');
        const qrError   = enrollModalEl.querySelector('#mfaQrError');
        const codeMan   = enrollModalEl.querySelector('#mfaManualCode');

        if (qrBase64) {
            if (qrImg) {
                qrImg.src = 'data:image/png;base64,' + qrBase64;
                qrImg.style.display = '';   // quita el display:none que venía del render inicial
            }
            if (qrError) qrError.style.display = 'none';
        } else {
            // Si por alguna razón el server no devolvió QR, mostramos el mensaje de error.
            if (qrImg) {
                qrImg.removeAttribute('src');
                qrImg.style.display = 'none';
            }
            if (qrError) qrError.style.display = '';
        }

        if (codeMan) codeMan.innerText = manualKey || '';

        // Resetea los OTP boxes y el hidden Code del enroll
        enrollModalEl.querySelectorAll('#otpEnroll .otp-box').forEach(i => i.value = '');
        const hidden = enrollModalEl.querySelector('#otpEnroll input[name="Code"]');
        if (hidden) hidden.value = '';
    }

    // Cierra todas las modales visibles y, cuando la última terminó de cerrarse,
    // ejecuta el callback. Bootstrap dispara 'hidden.bs.modal' al final de la animación,
    // momento en el que el backdrop ya fue removido y es seguro abrir otra modal.
    function hideAllModalsThen(callback) {
        const visible = Array.from(document.querySelectorAll('.modal.show'));
        if (visible.length === 0) {
            callback();
            return;
        }
        const last = visible[visible.length - 1];
        const onHidden = function () {
            last.removeEventListener('hidden.bs.modal', onHidden);
            // micro-delay defensivo por si quedó algún backdrop transicionando
            setTimeout(callback, 50);
        };
        last.addEventListener('hidden.bs.modal', onHidden);

        visible.forEach(function (m) {
            const inst = bootstrap.Modal.getInstance(m);
            if (inst) inst.hide();
        });
    }

    function openEnrollModal() {
        const el = document.getElementById('mfaEnrollModal');
        if (!el) return;
        const modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: 'static', keyboard: false });
        modal.show();
    }

    function openBlockedModal(bloqueoHasta) {
        const txt = document.getElementById('bloqueoHastaText');
        if (txt) txt.innerText = bloqueoHasta || 'No disponible';
        const el = document.getElementById('mfaBlockedModal');
        if (!el) return;
        const modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: 'static', keyboard: false });
        modal.show();
    }

    async function submitMfaFormAjax(formId, endpointUrl, errorContainerId) {
        const form = document.getElementById(formId);
        if (!form) return;

        form.addEventListener('submit', async function (e) {
            e.preventDefault();

            const btnSubmit = form.querySelector('button[type="submit"]');
            const originalText = btnSubmit ? btnSubmit.innerHTML : '';
            if (btnSubmit) {
                btnSubmit.disabled = true;
                btnSubmit.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Procesando...';
            }

            let errorDiv = document.getElementById(errorContainerId);
            if (!errorDiv) {
                errorDiv = document.createElement('div');
                errorDiv.id = errorContainerId;
                errorDiv.className = 'alert mb-3';
                form.insertBefore(errorDiv, form.firstChild);
            }
            errorDiv.style.display = 'none';
            errorDiv.className = 'alert alert-danger mb-3';

            try {
                const formData = new FormData(form);
                const response = await fetch(endpointUrl, {
                    method: 'POST',
                    body: formData,
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await response.json();

                if (result.success) {
                    if (result.redirectUrl) {
                        if (btnSubmit) btnSubmit.innerHTML = '¡Éxito!';
                        window.location.href = result.redirectUrl;
                        return;
                    }

                    if (result.isInfo) {
                        errorDiv.className = 'alert alert-info mb-3';
                        errorDiv.innerText = result.message || '';
                        errorDiv.style.display = 'block';
                        if (btnSubmit) {
                            btnSubmit.disabled = false;
                            btnSubmit.innerHTML = originalText;
                        }
                        return;
                    }

                    if (result.switchToEnroll) {
                        if (btnSubmit) btnSubmit.innerHTML = '¡Éxito!';

                        // 1) Pintamos primero el contenido del enroll (QR, clave, OTP limpio).
                        //    Ojo: lo hacemos ANTES de animar la salida de la modal actual.
                        paintEnrollModal(result.qrBase64, result.manualKey);

                        // 2) Cerramos la(s) modal(es) abierta(s) y, una vez cerradas, abrimos enroll.
                        hideAllModalsThen(function () {
                            openEnrollModal();
                            // Restaurar el botón por si el usuario regresa a esta vista
                            if (btnSubmit) {
                                btnSubmit.disabled = false;
                                btnSubmit.innerHTML = originalText;
                            }
                        });
                        return;
                    }

                    // success sin acción específica: rehabilitamos botón
                    if (btnSubmit) {
                        btnSubmit.disabled = false;
                        btnSubmit.innerHTML = originalText;
                    }
                    return;
                }

                if (result.blocked) {
                    const currentModalEl = form.closest('.modal');
                    hideAllModalsThen(function () {
                        openBlockedModal(result.bloqueoHasta);
                    });
                    if (currentModalEl) {
                        const inst = bootstrap.Modal.getInstance(currentModalEl);
                        if (inst) inst.hide();
                    }
                    return;
                }

                // Error normal: mostrar mensaje y limpiar OTP
                errorDiv.innerText = result.message || 'Operación no exitosa.';
                errorDiv.style.display = 'block';
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalText;
                }
                const inputs = form.querySelectorAll('.otp-box');
                inputs.forEach(i => i.value = '');
                if (inputs.length > 0) inputs[0].focus();

            } catch (err) {
                console.error(err);
                errorDiv.innerText = 'Error de comunicación con el servidor.';
                errorDiv.style.display = 'block';
                if (btnSubmit) {
                    btnSubmit.disabled = false;
                    btnSubmit.innerHTML = originalText;
                }
            }
        });
    }

    function initOtp(containerSelector) {
        const container = document.querySelector(containerSelector);
        if (!container) return;
        const inputs = container.querySelectorAll('.otp-box');
        const hidden = container.querySelector('input[type="hidden"][name="Code"]');
        if (!inputs.length || !hidden) return;

        const syncHidden = () => {
            hidden.value = Array.from(inputs).map(i => i.value || '').join('');
        };

        inputs.forEach((input, idx) => {
            input.addEventListener('input', () => {
                input.value = (input.value || '').replace(/\D/g, '').slice(0, 1);
                if (input.value && idx < inputs.length - 1) inputs[idx + 1].focus();
                syncHidden();
            });
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !input.value && idx > 0) inputs[idx - 1].focus();
            });
            input.addEventListener('paste', (e) => {
                const text = (e.clipboardData || window.clipboardData).getData('text');
                const digits = (text || '').replace(/\D/g, '').slice(0, inputs.length);
                if (!digits) return;
                e.preventDefault();
                digits.split('').forEach((d, i) => { if (inputs[i]) inputs[i].value = d; });
                const next = inputs[Math.min(digits.length, inputs.length - 1)];
                if (next) next.focus();
                syncHidden();
            });
        });
        inputs[0].focus();
    }

    // Inicializa los OTP cuando cada modal se muestra.
    document.addEventListener('shown.bs.modal', function (e) {
        if (!e.target) return;
        if (e.target.id === 'mfaVerifyModal') initOtp('#otpVerify');
        if (e.target.id === 'mfaEnrollModal') initOtp('#otpEnroll');
        if (e.target.id === 'mfaResetModal')  initOtp('#otpReset');
    });

    document.addEventListener('DOMContentLoaded', function () {
        submitMfaFormAjax('frmMfaVerify',        '/MfaOrquestador/VerifyAjax',        'verifyErrorContainer');
        submitMfaFormAjax('otpEnroll',           '/MfaOrquestador/EnrollConfirmAjax', 'enrollErrorContainer');
        submitMfaFormAjax('frmMfaResetReq',      '/MfaOrquestador/ResetRequestAjax',  'resetReqErrorContainer');
        submitMfaFormAjax('frmMfaResetConfirm',  '/MfaOrquestador/ResetConfirmAjax',  'resetConfirmErrorContainer');

        const show = '@(mfaShow ? "1" : "0")';
        const mode = '@mfaMode'.toLowerCase();
        if (show === '1') {
            let modalId = null;
            if      (mode === 'enroll')  modalId = 'mfaEnrollModal';
            else if (mode === 'verify')  modalId = 'mfaVerifyModal';
            else if (mode === 'reset')   modalId = 'mfaResetModal';
            else if (mode === 'blocked') modalId = 'mfaBlockedModal';
            else if (mode === 'svcdown') modalId = 'mfaServiceDownModal';
            if (modalId) {
                const el = document.getElementById(modalId);
                if (el) {
                    const modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: 'static', keyboard: false });
                    modal.show();
                }
            }
        }
    });
</script>
